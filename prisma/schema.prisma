  user_name     String
  user_email    String?
  username      String
  password_hash String
  is_active     Boolean           @default(true)
  role_id       Int
  assigned_at   DateTime          @default(now())
  role          SportsDynamicRole @relation(fields: [role_id], references: [role_id], onDelete: Cascade)

