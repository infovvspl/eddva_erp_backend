// ============================================================
// ACCOUNTS MODULE (Chart of Accounts, Vouchers, Ledger, Reports)
// Uses core RBAC (User/Role/Permission) — not a satellite RBAC.
// voucher_entries is the append-only source of truth; ledger and
// reports are read-only queries over it, never separate tables.
// ============================================================

model FinancialYear {
  id          String              @id @default(uuid())
  instituteId String?
  fyLabel     String
  startDate   DateTime
  endDate     DateTime
  status      FinancialYearStatus @default(OPEN)
  closedAt    DateTime?
  closedBy    String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  vouchers       Voucher[]
  periodBalances AccountPeriodBalance[]

  @@unique([instituteId, fyLabel])
  @@index([instituteId, status])
  @@map("financial_years")
}

model AccountGroup {
  id            String         @id @default(uuid())
  instituteId   String?
  groupName     String
  parentGroupId String?
  parentGroup   AccountGroup?  @relation("GroupHierarchy", fields: [parentGroupId], references: [id])
  childGroups   AccountGroup[] @relation("GroupHierarchy")
  nature        AccountNature
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  ledgerAccounts LedgerAccount[]

  @@unique([instituteId, groupName])
  @@index([instituteId])
  @@map("account_groups")
}

model LedgerAccount {
  id                 String       @id @default(uuid())
  instituteId        String?
  accountCode        String
  accountName        String
  groupId            String
  group              AccountGroup @relation(fields: [groupId], references: [id])
  openingBalance     Decimal      @default(0) @db.Decimal(14, 2)
  openingBalanceType BalanceType  @default(DEBIT)
  allowVoucherEntry  Boolean      @default(true)
  isActive           Boolean      @default(true)
  isCashAccount      Boolean      @default(false)
  isBankAccount      Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  voucherEntries VoucherEntry[]
  periodBalances AccountPeriodBalance[]
  mappings       AccountMapping[]

  @@unique([instituteId, accountCode])
  @@index([instituteId, isActive])
  @@index([groupId])
  @@map("ledger_accounts")
}

model CostCenter {
  id          String   @id @default(uuid())
  instituteId String?
  name        String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  voucherEntries VoucherEntry[]

  @@unique([instituteId, name])
  @@index([instituteId])
  @@map("cost_centers")
}

model VoucherType {
  id       String  @id @default(uuid())
  code     String  @unique
  name     String
  prefix   String
  isActive Boolean @default(true)

  vouchers Voucher[]

  @@map("voucher_types")
}

// FY-scoped atomic sequence for voucher numbering. Deliberately separate from
// NumberingService/number_sequences: that service derives its financial-year
// string from the document date via a fixed Apr-Mar rule, whereas Voucher
// numbers must be unique per (voucherTypeId, fyId) against this module's own
// user-managed FinancialYear entity, which need not follow that rule.
model VoucherNumberSequence {
  id            String @id @default(uuid())
  voucherTypeId String
  fyId          String
  currentNumber Int    @default(0)

  @@unique([voucherTypeId, fyId])
  @@map("voucher_number_sequences")
}

model Voucher {
  id                String        @id @default(uuid())
  instituteId       String?
  voucherNumber     String
  voucherTypeId     String
  voucherType       VoucherType   @relation(fields: [voucherTypeId], references: [id])
  fyId              String
  financialYear     FinancialYear @relation(fields: [fyId], references: [id])
  voucherDate       DateTime
  narration         String?
  referenceNo       String?
  totalDebit        Decimal       @default(0) @db.Decimal(14, 2)
  totalCredit       Decimal       @default(0) @db.Decimal(14, 2)
  status            VoucherStatus @default(DRAFT)
  isAutoPosted      Boolean       @default(false)
  sourceModule      String?
  sourceReferenceId String?
  createdBy         String
  approvedBy        String?
  postedAt          DateTime?
  cancelledAt       DateTime?
  cancelledBy       String?
  reversalOfId      String?       @unique
  reversalOf        Voucher?      @relation("VoucherReversal", fields: [reversalOfId], references: [id])
  reversedBy        Voucher?      @relation("VoucherReversal")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  entries     VoucherEntry[]
  attachments VoucherAttachment[]

  @@unique([voucherTypeId, fyId, voucherNumber])
  @@unique([sourceModule, sourceReferenceId])
  @@index([fyId, status])
  @@index([instituteId, voucherDate])
  @@map("vouchers")
}

model VoucherEntry {
  id           String        @id @default(uuid())
  voucherId    String
  voucher      Voucher       @relation(fields: [voucherId], references: [id])
  accountId    String
  account      LedgerAccount @relation(fields: [accountId], references: [id])
  debitAmount  Decimal       @default(0) @db.Decimal(14, 2)
  creditAmount Decimal       @default(0) @db.Decimal(14, 2)
  costCenterId String?
  costCenter   CostCenter?   @relation(fields: [costCenterId], references: [id])
  narration    String?
  voucherDate  DateTime
  createdAt    DateTime      @default(now())

  @@index([accountId, voucherDate])
  @@index([voucherId])
  @@index([costCenterId])
  @@map("voucher_entries")
}

model VoucherAttachment {
  id         String   @id @default(uuid())
  voucherId  String
  voucher    Voucher  @relation(fields: [voucherId], references: [id])
  fileUrl    String
  uploadedBy String
  uploadedAt DateTime @default(now())

  @@index([voucherId])
  @@map("voucher_attachments")
}

model AccountPeriodBalance {
  id                 String        @id @default(uuid())
  fyId               String
  financialYear      FinancialYear @relation(fields: [fyId], references: [id])
  accountId          String
  account            LedgerAccount @relation(fields: [accountId], references: [id])
  openingBalance     Decimal       @db.Decimal(14, 2)
  openingBalanceType BalanceType
  closingBalance     Decimal       @db.Decimal(14, 2)
  closingBalanceType BalanceType
  createdAt          DateTime      @default(now())

  @@unique([fyId, accountId])
  @@map("account_period_balances")
}

model AccountMapping {
  id          String        @id @default(uuid())
  instituteId String?
  mappingKey  String
  accountId   String
  account     LedgerAccount @relation(fields: [accountId], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([instituteId, mappingKey])
  @@map("account_mappings")
}

// Parallel dynamic-role RBAC for Accounts — same architecture as
// Library/Sports/Canteen/Front Office/Inventory/Transport: an independent
// JWT space for Accounts staff (Accounts Clerk/Accountant/Finance Admin) who
// may or may not exist as core `users` rows.
model AccountsDynamicRole {
  role_id      Int      @id @default(autoincrement())
  institute_id String
  name         String
  description  String?
  permissions  Json     @default("[]")
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  user_roles AccountsUserDynamicRole[]

  @@unique([institute_id, name])
  @@map("accounts_dynamic_roles")
}

model AccountsUserDynamicRole {
  id            Int                 @id @default(autoincrement())
  institute_id  String
  eddva_user_id String
  user_name     String
  user_email    String?
  username      String
  password_hash String
  is_active     Boolean             @default(true)
  role_id       Int
  assigned_at   DateTime            @default(now())
  role          AccountsDynamicRole @relation(fields: [role_id], references: [role_id], onDelete: Cascade)

  @@unique([institute_id, eddva_user_id])
  @@unique([institute_id, username])
  @@map("accounts_user_dynamic_roles")
}

model AccountsSsoSession {
  session_id    Int      @id @default(autoincrement())
  institute_id  String
  eddva_user_id String
  user_name     String
  user_email    String?
  user_role     String
  acc_token     String   @unique
  expires_at    DateTime
  created_at    DateTime @default(now())

  @@map("accounts_sso_sessions")
}

model AccountsPermission {
  permission_id Int      @id @default(autoincrement())
  key           String   @unique
  resource      String
  action        String
  name          String
  category      String
  description   String?
  is_system     Boolean  @default(true)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@map("accounts_permissions_catalog")
}

// ─────────────────────────────────────────────────────────────────────────
// Sales & Purchase Management Module
// Masters (vendors/customers/items/item categories/UOM/tax codes/payment
// terms/warehouses) → Purchase (PO → approval → GRN → Purchase Invoice,
// three-way matched → Purchase Payment) → Sales (Sales Order → Sales
// Invoice → Sales Receipt) → read-only Purchase/Sales Registers (queries
// over posted invoices — never separate tables).
//
// RBAC is the same parallel dynamic-role architecture as Front Office/
// Inventory/Transport (independent JWT, SSO exchange + direct login,
// dynamic roles with a live resource:action permission catalog). Top-level
// masters and documents carry institute_id, mirroring Transport's
// multi-tenant scoping (chosen over Inventory's single-tenant style since
// these are per-institute financial records).
//
// Financial-year-aware document numbering reuses the core NumberingService
// (number_sequences / DocumentType) rather than a parallel mechanism.
// Deliberately does NOT FK into Accounts' FinancialYear model — each RBAC
// island (Accounts included) stays independent, so financial_year columns
// below store the same FY label string NumberingService already derives
// (e.g. "2026-27") rather than a cross-module foreign key.
// ─────────────────────────────────────────────────────────────────────────

enum SpPartyStatus {
  ACTIVE
  INACTIVE
  BLACKLISTED
}

enum SpPaymentMode {
  CASH
  BANK_TRANSFER
  UPI
  CHEQUE
  CARD
  OTHER
}

enum SpItemStatus {
  ACTIVE
  INACTIVE
}

enum SpPoStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PARTIALLY_RECEIVED
  CLOSED
  CANCELLED
}

enum SpPoApprovalAction {
  APPROVED
  REJECTED
}

enum SpGrnStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum SpInvoiceStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum SpPaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum SpSoStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_INVOICED
  CLOSED
  CANCELLED
}

model SpVendor {
  vendor_id       Int            @id @default(autoincrement())
  institute_id    String
  vendor_code     String
  vendor_name     String
  gstin           String?
  tax_id          String?
  address_line1   String?
  address_line2   String?
  city            String?
  state           String?
  pincode         String?
  payment_term_id Int?
  payment_term    SpPaymentTerm? @relation(fields: [payment_term_id], references: [payment_term_id])
  credit_limit    Decimal        @default(0) @db.Decimal(14, 2)
  status          SpPartyStatus  @default(ACTIVE)
  created_by      String?
  updated_by      String?
  deleted_at      DateTime?
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt

  contacts          SpVendorContact[]
  bank_details      SpVendorBankDetail[]
  purchase_orders   SpPurchaseOrder[]
  grns              SpGrn[]
  purchase_invoices SpPurchaseInvoice[]

  @@unique([institute_id, vendor_code])
  @@index([institute_id, status])
  @@index([vendor_name])
  @@index([gstin])
  @@map("sp_vendors")
}

model SpVendorContact {
  contact_id  Int      @id @default(autoincrement())
  vendor_id   Int
  vendor      SpVendor @relation(fields: [vendor_id], references: [vendor_id], onDelete: Cascade)
  name        String
  designation String?
  phone       String?
  email       String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@index([vendor_id])
  @@map("sp_vendor_contacts")
}

model SpVendorBankDetail {
  bank_id    Int      @id @default(autoincrement())
  vendor_id  Int
  vendor     SpVendor @relation(fields: [vendor_id], references: [vendor_id], onDelete: Cascade)
  account_no String
  ifsc       String?
  swift      String?
  bank_name  String
  is_primary Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([vendor_id])
  @@map("sp_vendor_bank_details")
}

model SpCustomer {
  customer_id     Int            @id @default(autoincrement())
  institute_id    String
  customer_code   String
  customer_name   String
  gstin           String?
  tax_id          String?
  address_line1   String?
  address_line2   String?
  city            String?
  state           String?
  pincode         String?
  payment_term_id Int?
  payment_term    SpPaymentTerm? @relation(fields: [payment_term_id], references: [payment_term_id])
  credit_limit    Decimal        @default(0) @db.Decimal(14, 2)
  status          SpPartyStatus  @default(ACTIVE)
  created_by      String?
  updated_by      String?
  deleted_at      DateTime?
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt

  contacts       SpCustomerContact[]
  sales_orders   SpSalesOrder[]
  sales_invoices SpSalesInvoice[]

  @@unique([institute_id, customer_code])
  @@index([institute_id, status])
  @@index([customer_name])
  @@index([gstin])
  @@map("sp_customers")
}

model SpCustomerContact {
  contact_id  Int        @id @default(autoincrement())
  customer_id Int
  customer    SpCustomer @relation(fields: [customer_id], references: [customer_id], onDelete: Cascade)
  name        String
  designation String?
  phone       String?
  email       String?
  created_at  DateTime   @default(now())
  updated_at  DateTime   @updatedAt

  @@index([customer_id])
  @@map("sp_customer_contacts")
}

model SpItemCategory {
  category_id  Int      @id @default(autoincrement())
  institute_id String
  name         String
  status       Status   @default(ACTIVE)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  items SpItem[]

  @@unique([institute_id, name])
  @@map("sp_item_categories")
}

model SpUom {
  uom_id       Int      @id @default(autoincrement())
  institute_id String
  name         String
  symbol       String
  status       Status   @default(ACTIVE)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  items SpItem[]

  @@unique([institute_id, name])
  @@map("sp_uoms")
}

// Tax codes are versioned, never edited in place once used — a rate change
// creates a new row with a later effective_from instead of mutating the old
// one. Transaction lines always snapshot their own rates/amounts regardless,
// so historical documents never depend on this table's current contents.
model SpTaxCode {
  tax_code_id    Int      @id @default(autoincrement())
  institute_id   String
  name           String
  cgst_pct       Decimal  @default(0) @db.Decimal(5, 2)
  sgst_pct       Decimal  @default(0) @db.Decimal(5, 2)
  igst_pct       Decimal  @default(0) @db.Decimal(5, 2)
  effective_from DateTime @db.Date
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now())
  created_by     String?

  items    SpItem[]
  po_items SpPurchaseOrderItem[]
  so_items SpSalesOrderItem[]

  @@index([institute_id, name, effective_from])
  @@map("sp_tax_codes")
}

model SpPaymentTerm {
  payment_term_id Int      @id @default(autoincrement())
  institute_id    String
  term_name       String
  days            Int
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  vendors   SpVendor[]
  customers SpCustomer[]

  @@unique([institute_id, term_name])
  @@map("sp_payment_terms")
}

model SpWarehouse {
  warehouse_id Int      @id @default(autoincrement())
  institute_id String
  name         String
  address      String?
  is_default   Boolean  @default(false)
  status       Status   @default(ACTIVE)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  purchase_orders SpPurchaseOrder[]
  grns            SpGrn[]

  @@unique([institute_id, name])
  @@map("sp_warehouses")
}

model SpItem {
  item_id        Int            @id @default(autoincrement())
  institute_id   String
  item_code      String
  item_name      String
  category_id    Int
  category       SpItemCategory @relation(fields: [category_id], references: [category_id])
  uom_id         Int
  uom            SpUom          @relation(fields: [uom_id], references: [uom_id])
  hsn_sac_code   String?
  purchase_price Decimal        @default(0) @db.Decimal(14, 2)
  sales_price    Decimal        @default(0) @db.Decimal(14, 2)
  tax_code_id    Int?
  tax_code       SpTaxCode?     @relation(fields: [tax_code_id], references: [tax_code_id])
  status         SpItemStatus   @default(ACTIVE)
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt

  po_items  SpPurchaseOrderItem[]
  grn_items SpGrnItem[]
  pi_items  SpPurchaseInvoiceItem[]
  so_items  SpSalesOrderItem[]
  si_items  SpSalesInvoiceItem[]

  @@unique([institute_id, item_code])
  @@index([institute_id, status])
  @@index([item_name])
  @@map("sp_items")
}

model SpPurchaseOrder {
  po_id                  Int         @id @default(autoincrement())
  institute_id           String
  po_number              String
  financial_year         String
  vendor_id              Int
  vendor                 SpVendor    @relation(fields: [vendor_id], references: [vendor_id])
  po_date                DateTime    @db.Date
  expected_delivery_date DateTime?   @db.Date
  warehouse_id           Int
  warehouse              SpWarehouse @relation(fields: [warehouse_id], references: [warehouse_id])
  status                 SpPoStatus  @default(DRAFT)
  subtotal               Decimal     @default(0) @db.Decimal(14, 2)
  tax_amount             Decimal     @default(0) @db.Decimal(14, 2)
  discount               Decimal     @default(0) @db.Decimal(14, 2)
  grand_total            Decimal     @default(0) @db.Decimal(14, 2)
  created_by             String
  submitted_at           DateTime?
  approved_by            String?
  approved_at            DateTime?
  rejected_by            String?
  rejected_at            DateTime?
  rejection_reason       String?
  cancelled_by           String?
  cancelled_at           DateTime?
  created_at             DateTime    @default(now())
  updated_at             DateTime    @updatedAt

  items             SpPurchaseOrderItem[]
  approvals         SpPoApproval[]
  grns              SpGrn[]
  purchase_invoices SpPurchaseInvoice[]

  @@unique([institute_id, po_number])
  @@index([institute_id, status])
  @@index([vendor_id])
  @@index([po_date])
  @@map("sp_purchase_orders")
}

model SpPurchaseOrderItem {
  po_item_id        Int             @id @default(autoincrement())
  purchase_order_id Int
  purchase_order    SpPurchaseOrder @relation(fields: [purchase_order_id], references: [po_id], onDelete: Cascade)
  item_id           Int
  item              SpItem          @relation(fields: [item_id], references: [item_id])
  quantity          Decimal         @db.Decimal(14, 3)
  unit_price        Decimal         @db.Decimal(14, 2)
  tax_code_id       Int?
  tax_code          SpTaxCode?      @relation(fields: [tax_code_id], references: [tax_code_id])
  line_discount     Decimal         @default(0) @db.Decimal(14, 2)
  line_tax_amount   Decimal         @default(0) @db.Decimal(14, 2)
  line_total        Decimal         @default(0) @db.Decimal(14, 2)
  received_qty      Decimal         @default(0) @db.Decimal(14, 3)
  created_at        DateTime        @default(now())
  updated_at        DateTime        @updatedAt

  grn_items SpGrnItem[]
  pi_items  SpPurchaseInvoiceItem[]

  @@index([purchase_order_id])
  @@index([item_id])
  @@map("sp_purchase_order_items")
}

model SpPoApproval {
  approval_id Int                @id @default(autoincrement())
  po_id       Int
  po          SpPurchaseOrder    @relation(fields: [po_id], references: [po_id], onDelete: Cascade)
  approver_id String
  action      SpPoApprovalAction
  remarks     String?
  action_at   DateTime           @default(now())

  @@index([po_id])
  @@map("sp_po_approvals")
}

// Configurable approval thresholds (section 21/22 of the module spec) —
// amount bands optionally tied to a required approver role, evaluated in
// `sequence` order so a very large PO can require multiple sign-offs. Never
// hardcoded in application logic.
model SpApprovalRule {
  rule_id          Int                       @id @default(autoincrement())
  institute_id     String
  name             String
  min_amount       Decimal                   @default(0) @db.Decimal(14, 2)
  max_amount       Decimal?                  @db.Decimal(14, 2)
  approver_role_id Int?
  approver_role    SalesPurchaseDynamicRole? @relation(fields: [approver_role_id], references: [role_id])
  sequence         Int                       @default(1)
  is_active        Boolean                   @default(true)
  created_at       DateTime                  @default(now())
  updated_at       DateTime                  @updatedAt

  @@index([institute_id, is_active, min_amount])
  @@map("sp_approval_rules")
}

model SpGrn {
  grn_id            Int             @id @default(autoincrement())
  institute_id      String
  grn_number        String
  financial_year    String
  purchase_order_id Int
  purchase_order    SpPurchaseOrder @relation(fields: [purchase_order_id], references: [po_id])
  vendor_id         Int
  vendor            SpVendor        @relation(fields: [vendor_id], references: [vendor_id])
  received_date     DateTime        @db.Date
  warehouse_id      Int
  warehouse         SpWarehouse     @relation(fields: [warehouse_id], references: [warehouse_id])
  status            SpGrnStatus     @default(DRAFT)
  created_by        String
  cancelled_by      String?
  cancelled_at      DateTime?
  created_at        DateTime        @default(now())
  updated_at        DateTime        @updatedAt

  items             SpGrnItem[]
  purchase_invoices SpPurchaseInvoice[]

  @@unique([institute_id, grn_number])
  @@index([institute_id, status])
  @@index([purchase_order_id])
  @@index([vendor_id])
  @@map("sp_grns")
}

model SpGrnItem {
  grn_item_id  Int                 @id @default(autoincrement())
  grn_id       Int
  grn          SpGrn               @relation(fields: [grn_id], references: [grn_id], onDelete: Cascade)
  po_item_id   Int
  po_item      SpPurchaseOrderItem @relation(fields: [po_item_id], references: [po_item_id])
  item_id      Int
  item         SpItem              @relation(fields: [item_id], references: [item_id])
  received_qty Decimal             @db.Decimal(14, 3)
  accepted_qty Decimal             @db.Decimal(14, 3)
  rejected_qty Decimal             @default(0) @db.Decimal(14, 3)
  created_at   DateTime            @default(now())

  pi_items SpPurchaseInvoiceItem[]

  @@index([grn_id])
  @@index([po_item_id])
  @@map("sp_grn_items")
}

model SpPurchaseInvoice {
  pi_id                 Int              @id @default(autoincrement())
  institute_id          String
  invoice_number        String
  financial_year        String
  vendor_invoice_number String
  vendor_id             Int
  vendor                SpVendor         @relation(fields: [vendor_id], references: [vendor_id])
  purchase_order_id     Int?
  purchase_order        SpPurchaseOrder? @relation(fields: [purchase_order_id], references: [po_id])
  grn_id                Int?
  grn                   SpGrn?           @relation(fields: [grn_id], references: [grn_id])
  invoice_date          DateTime         @db.Date
  due_date              DateTime?        @db.Date
  subtotal              Decimal          @default(0) @db.Decimal(14, 2)
  tax_amount            Decimal          @default(0) @db.Decimal(14, 2)
  discount              Decimal          @default(0) @db.Decimal(14, 2)
  grand_total           Decimal          @default(0) @db.Decimal(14, 2)
  paid_amount           Decimal          @default(0) @db.Decimal(14, 2)
  payment_status        SpPaymentStatus  @default(UNPAID)
  status                SpInvoiceStatus  @default(DRAFT)
  created_by            String
  posted_by             String?
  posted_at             DateTime?
  cancelled_by          String?
  cancelled_at          DateTime?
  created_at            DateTime         @default(now())
  updated_at            DateTime         @updatedAt

  items    SpPurchaseInvoiceItem[]
  payments SpPurchasePayment[]

  @@unique([institute_id, invoice_number])
  @@index([institute_id, status, invoice_date])
  @@index([vendor_id])
  @@index([purchase_order_id])
  @@index([grn_id])
  @@index([vendor_invoice_number])
  @@map("sp_purchase_invoices")
}

// Snapshot of commercial/tax values at posting time — later changes to
// SpItem price, SpTaxCode rates, or the item master must never alter these.
model SpPurchaseInvoiceItem {
  pi_item_id    Int                  @id @default(autoincrement())
  pi_id         Int
  invoice       SpPurchaseInvoice    @relation(fields: [pi_id], references: [pi_id], onDelete: Cascade)
  po_item_id    Int?
  po_item       SpPurchaseOrderItem? @relation(fields: [po_item_id], references: [po_item_id])
  grn_item_id   Int?
  grn_item      SpGrnItem?           @relation(fields: [grn_item_id], references: [grn_item_id])
  item_id       Int
  item          SpItem               @relation(fields: [item_id], references: [item_id])
  quantity      Decimal              @db.Decimal(14, 3)
  unit_price    Decimal              @db.Decimal(14, 2)
  cgst_rate     Decimal              @default(0) @db.Decimal(5, 2)
  sgst_rate     Decimal              @default(0) @db.Decimal(5, 2)
  igst_rate     Decimal              @default(0) @db.Decimal(5, 2)
  cgst_amount   Decimal              @default(0) @db.Decimal(14, 2)
  sgst_amount   Decimal              @default(0) @db.Decimal(14, 2)
  igst_amount   Decimal              @default(0) @db.Decimal(14, 2)
  line_discount Decimal              @default(0) @db.Decimal(14, 2)
  line_total    Decimal              @default(0) @db.Decimal(14, 2)

  @@index([pi_id])
  @@index([item_id])
  @@map("sp_purchase_invoice_items")
}

model SpPurchasePayment {
  payment_id   Int               @id @default(autoincrement())
  institute_id String
  pi_id        Int
  invoice      SpPurchaseInvoice @relation(fields: [pi_id], references: [pi_id])
  payment_date DateTime          @db.Date
  amount       Decimal           @db.Decimal(14, 2)
  mode         SpPaymentMode
  reference_no String?
  created_by   String
  created_at   DateTime          @default(now())
  updated_at   DateTime          @updatedAt

  @@index([pi_id])
  @@index([institute_id, payment_date])
  @@map("sp_purchase_payments")
}

model SpSalesOrder {
  so_id          Int        @id @default(autoincrement())
  institute_id   String
  so_number      String
  financial_year String
  customer_id    Int
  customer       SpCustomer @relation(fields: [customer_id], references: [customer_id])
  so_date        DateTime   @db.Date
  delivery_date  DateTime?  @db.Date
  status         SpSoStatus @default(DRAFT)
  subtotal       Decimal    @default(0) @db.Decimal(14, 2)
  tax_amount     Decimal    @default(0) @db.Decimal(14, 2)
  discount       Decimal    @default(0) @db.Decimal(14, 2)
  grand_total    Decimal    @default(0) @db.Decimal(14, 2)
  created_by     String
  confirmed_at   DateTime?
  cancelled_by   String?
  cancelled_at   DateTime?
  created_at     DateTime   @default(now())
  updated_at     DateTime   @updatedAt

  items          SpSalesOrderItem[]
  sales_invoices SpSalesInvoice[]

  @@unique([institute_id, so_number])
  @@index([institute_id, status])
  @@index([customer_id])
  @@index([so_date])
  @@map("sp_sales_orders")
}

model SpSalesOrderItem {
  so_item_id      Int          @id @default(autoincrement())
  sales_order_id  Int
  sales_order     SpSalesOrder @relation(fields: [sales_order_id], references: [so_id], onDelete: Cascade)
  item_id         Int
  item            SpItem       @relation(fields: [item_id], references: [item_id])
  quantity        Decimal      @db.Decimal(14, 3)
  unit_price      Decimal      @db.Decimal(14, 2)
  tax_code_id     Int?
  tax_code        SpTaxCode?   @relation(fields: [tax_code_id], references: [tax_code_id])
  line_discount   Decimal      @default(0) @db.Decimal(14, 2)
  line_tax_amount Decimal      @default(0) @db.Decimal(14, 2)
  line_total      Decimal      @default(0) @db.Decimal(14, 2)
  invoiced_qty    Decimal      @default(0) @db.Decimal(14, 3)
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  si_items SpSalesInvoiceItem[]

  @@index([sales_order_id])
  @@index([item_id])
  @@map("sp_sales_order_items")
}

model SpSalesInvoice {
  si_id          Int             @id @default(autoincrement())
  institute_id   String
  invoice_number String
  financial_year String
  customer_id    Int
  customer       SpCustomer      @relation(fields: [customer_id], references: [customer_id])
  sales_order_id Int?
  sales_order    SpSalesOrder?   @relation(fields: [sales_order_id], references: [so_id])
  invoice_date   DateTime        @db.Date
  due_date       DateTime?       @db.Date
  subtotal       Decimal         @default(0) @db.Decimal(14, 2)
  tax_amount     Decimal         @default(0) @db.Decimal(14, 2)
  discount       Decimal         @default(0) @db.Decimal(14, 2)
  grand_total    Decimal         @default(0) @db.Decimal(14, 2)
  paid_amount    Decimal         @default(0) @db.Decimal(14, 2)
  payment_status SpPaymentStatus @default(UNPAID)
  status         SpInvoiceStatus @default(DRAFT)
  created_by     String
  posted_by      String?
  posted_at      DateTime?
  cancelled_by   String?
  cancelled_at   DateTime?
  created_at     DateTime        @default(now())
  updated_at     DateTime        @updatedAt

  items    SpSalesInvoiceItem[]
  receipts SpSalesReceipt[]

  @@unique([institute_id, invoice_number])
  @@index([institute_id, status, invoice_date])
  @@index([customer_id])
  @@index([sales_order_id])
  @@map("sp_sales_invoices")
}

model SpSalesInvoiceItem {
  si_item_id    Int               @id @default(autoincrement())
  si_id         Int
  invoice       SpSalesInvoice    @relation(fields: [si_id], references: [si_id], onDelete: Cascade)
  so_item_id    Int?
  so_item       SpSalesOrderItem? @relation(fields: [so_item_id], references: [so_item_id])
  item_id       Int
  item          SpItem            @relation(fields: [item_id], references: [item_id])
  quantity      Decimal           @db.Decimal(14, 3)
  unit_price    Decimal           @db.Decimal(14, 2)
  cgst_rate     Decimal           @default(0) @db.Decimal(5, 2)
  sgst_rate     Decimal           @default(0) @db.Decimal(5, 2)
  igst_rate     Decimal           @default(0) @db.Decimal(5, 2)
  cgst_amount   Decimal           @default(0) @db.Decimal(14, 2)
  sgst_amount   Decimal           @default(0) @db.Decimal(14, 2)
  igst_amount   Decimal           @default(0) @db.Decimal(14, 2)
  line_discount Decimal           @default(0) @db.Decimal(14, 2)
  line_total    Decimal           @default(0) @db.Decimal(14, 2)

  @@index([si_id])
  @@index([item_id])
  @@map("sp_sales_invoice_items")
}

model SpSalesReceipt {
  receipt_id   Int            @id @default(autoincrement())
  institute_id String
  si_id        Int
  invoice      SpSalesInvoice @relation(fields: [si_id], references: [si_id])
  receipt_date DateTime       @db.Date
  amount       Decimal        @db.Decimal(14, 2)
  mode         SpPaymentMode
  reference_no String?
  created_by   String
  created_at   DateTime       @default(now())
  updated_at   DateTime       @updatedAt

  @@index([si_id])
  @@index([institute_id, receipt_date])
  @@map("sp_sales_receipts")
}

// ─── Sales & Purchase RBAC — parallel dynamic-role system, same architecture as Front Office/Inventory/Transport ───

model SalesPurchaseDynamicRole {
  role_id      Int      @id @default(autoincrement())
  institute_id String
  name         String
  description  String?
  permissions  Json     @default("[]")
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  user_roles     SalesPurchaseUserDynamicRole[]
  approval_rules SpApprovalRule[]

  @@unique([institute_id, name])
  @@map("sales_purchase_dynamic_roles")
}

model SalesPurchaseUserDynamicRole {
  id            Int                      @id @default(autoincrement())
  institute_id  String
  eddva_user_id String
  user_name     String
  user_email    String?
  username      String
  password_hash String
  is_active     Boolean                  @default(true)
  role_id       Int
  assigned_at   DateTime                 @default(now())
  role          SalesPurchaseDynamicRole @relation(fields: [role_id], references: [role_id], onDelete: Cascade)

  @@unique([institute_id, eddva_user_id])
  @@unique([institute_id, username])
  @@map("sales_purchase_user_dynamic_roles")
}

model SalesPurchaseSsoSession {
  session_id    Int      @id @default(autoincrement())
  institute_id  String
  eddva_user_id String
  user_name     String
  user_email    String?
  user_role     String
  sp_token      String   @unique
  expires_at    DateTime
  created_at    DateTime @default(now())

  @@map("sales_purchase_sso_sessions")
}

model SalesPurchasePermission {
  permission_id Int      @id @default(autoincrement())
  key           String   @unique
  resource      String
  action        String
  name          String
  category      String
  description   String?
  is_system     Boolean  @default(true)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@map("sales_purchase_permissions_catalog")
}
