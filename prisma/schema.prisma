// ─────────────────────────────────────────────────────────────────────────
// Front Office Management Module
// Shared by: Visitor Register, Enquiry Register, Appointment Management,
// Complaint Register. Reuses core User/Role/Permission RBAC and the global
// AuditLog (audit.service.ts) — does not introduce a parallel auth system.
// ─────────────────────────────────────────────────────────────────────────

model FrontOfficeDepartment {
  department_id Int      @id @default(autoincrement())
  name          String   @unique
  status        Status   @default(ACTIVE)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  employees    FrontOfficeEmployee[]
  appointments FrontOfficeAppointment[]

  @@map("front_office_departments")
}

model FrontOfficeEmployee {
  employee_id   Int                   @id @default(autoincrement())
  name          String
  department_id Int
  department    FrontOfficeDepartment @relation(fields: [department_id], references: [department_id])
  designation   String?
  email         String?               @unique
  phone         String?
  status        Status                @default(ACTIVE)
  created_at    DateTime              @default(now())
  updated_at    DateTime              @updatedAt

  hosted_appointments FrontOfficeAppointment[]      @relation("FOHostEmployee")
  hosted_visitor_logs FrontOfficeVisitorLog[]       @relation("FOHostEmployee")
  assigned_enquiries  FrontOfficeEnquiry[]          @relation("FOAssignedEnquiry")
  assigned_complaints FrontOfficeComplaint[]        @relation("FOAssignedComplaint")
  availability_slots  FrontOfficeAvailabilitySlot[]
  notifications       FrontOfficeNotification[]

  @@index([department_id])
  @@map("front_office_employees")
}

model FrontOfficeAvailabilitySlot {
  slot_id      Int                 @id @default(autoincrement())
  employee_id  Int
  employee     FrontOfficeEmployee @relation(fields: [employee_id], references: [employee_id], onDelete: Cascade)
  date         DateTime            @db.Date
  start_time   String // "HH:mm" 24h
  end_time     String // "HH:mm" 24h
  is_available Boolean             @default(true)
  created_at   DateTime            @default(now())

  @@index([employee_id, date])
  @@map("front_office_availability_slots")
}

model FrontOfficeVisitor {
  visitor_id      Int      @id @default(autoincrement())
  full_name       String
  phone           String?
  email           String?
  id_proof_type   String?
  id_proof_number String? // AES-256-GCM encrypted at rest — see front-office/common/id-proof-crypto.util.ts
  photo_url       String?
  organization    String?
  created_by      String? // eddva_user_id of the acting Front Office user — not an FK (may be a dynamic-role user with no core `users` row)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  visitor_logs FrontOfficeVisitorLog[]
  appointments FrontOfficeAppointment[]

  @@index([phone])
  @@index([email])
  @@index([full_name])
  @@map("front_office_visitors")
}

enum FrontOfficeVisitorLogStatus {
  checked_in
  checked_out
}

model FrontOfficeVisitorLog {
  log_id           Int                         @id @default(autoincrement())
  visitor_id       Int
  visitor          FrontOfficeVisitor          @relation(fields: [visitor_id], references: [visitor_id])
  host_employee_id Int
  host_employee    FrontOfficeEmployee         @relation("FOHostEmployee", fields: [host_employee_id], references: [employee_id])
  appointment_id   Int?                        @unique
  appointment      FrontOfficeAppointment?     @relation(fields: [appointment_id], references: [appointment_id])
  purpose          String?
  badge_number     String
  check_in_time    DateTime                    @default(now())
  check_out_time   DateTime?
  status           FrontOfficeVisitorLogStatus @default(checked_in)
  created_by       String? // eddva_user_id — not an FK
  created_at       DateTime                    @default(now())
  updated_at       DateTime                    @updatedAt

  @@index([visitor_id])
  @@index([host_employee_id])
  @@index([status])
  @@index([check_in_time])
  @@map("front_office_visitor_logs")
}

enum FrontOfficeEnquirySource {
  walk_in
  phone
  email
  website
}

enum FrontOfficeEnquiryStatus {
  open
  in_progress
  closed
}

model FrontOfficeEnquiry {
  enquiry_id    Int                      @id @default(autoincrement())
  enquirer_name String
  phone         String?
  email         String?
  source        FrontOfficeEnquirySource
  category      String
  description   String
  assigned_to   Int?
  assignee      FrontOfficeEmployee?     @relation("FOAssignedEnquiry", fields: [assigned_to], references: [employee_id])
  status        FrontOfficeEnquiryStatus @default(open)
  created_by    String? // eddva_user_id — not an FK
  created_at    DateTime                 @default(now())
  updated_at    DateTime                 @updatedAt

  followups FrontOfficeEnquiryFollowup[]

  @@index([phone])
  @@index([email])
  @@index([status, created_at])
  @@index([assigned_to, status])
  @@map("front_office_enquiries")
}

model FrontOfficeEnquiryFollowup {
  followup_id        Int                @id @default(autoincrement())
  enquiry_id         Int
  enquiry            FrontOfficeEnquiry @relation(fields: [enquiry_id], references: [enquiry_id], onDelete: Cascade)
  notes              String
  followup_date      DateTime           @default(now())
  next_followup_date DateTime?
  updated_by         String? // eddva_user_id — not an FK
  created_at         DateTime           @default(now())

  @@index([enquiry_id])
  @@index([next_followup_date])
  @@map("front_office_enquiry_followups")
}

enum FrontOfficeAppointmentStatus {
  scheduled
  confirmed
  completed
  cancelled
  no_show
}

model FrontOfficeAppointment {
  appointment_id   Int                          @id @default(autoincrement())
  visitor_id       Int?
  visitor          FrontOfficeVisitor?          @relation(fields: [visitor_id], references: [visitor_id])
  visitor_name     String
  phone            String?
  host_employee_id Int
  host_employee    FrontOfficeEmployee          @relation("FOHostEmployee", fields: [host_employee_id], references: [employee_id])
  department_id    Int
  department       FrontOfficeDepartment        @relation(fields: [department_id], references: [department_id])
  appointment_date DateTime                     @db.Date
  start_time       DateTime
  end_time         DateTime
  purpose          String?
  status           FrontOfficeAppointmentStatus @default(scheduled)
  created_by       String? // eddva_user_id — not an FK
  created_at       DateTime                     @default(now())
  updated_at       DateTime                     @updatedAt

  visitor_log FrontOfficeVisitorLog?

  @@index([host_employee_id, appointment_date])
  @@index([appointment_date, status])
  @@index([visitor_id])
  @@index([department_id])
  @@map("front_office_appointments")
}

enum FrontOfficeComplaintPriority {
  low
  medium
  high
  critical
}

enum FrontOfficeComplaintStatus {
  open
  in_progress
  resolved
  closed
}

model FrontOfficeComplaint {
  complaint_id     Int                          @id @default(autoincrement())
  complainant_name String
  phone            String?
  email            String?
  category         String
  description      String
  priority         FrontOfficeComplaintPriority @default(medium)
  status           FrontOfficeComplaintStatus   @default(open)
  assigned_to      Int?
  assignee         FrontOfficeEmployee?         @relation("FOAssignedComplaint", fields: [assigned_to], references: [employee_id])
  created_by       String? // eddva_user_id — not an FK
  created_at       DateTime                     @default(now())
  resolved_at      DateTime?
  updated_at       DateTime                     @updatedAt

  updates FrontOfficeComplaintUpdate[]

  @@index([phone])
  @@index([email])
  @@index([status, created_at])
  @@index([assigned_to, status])
  @@index([priority])
  @@map("front_office_complaints")
}

model FrontOfficeComplaintUpdate {
  update_id     Int                  @id @default(autoincrement())
  complaint_id  Int
  complaint     FrontOfficeComplaint @relation(fields: [complaint_id], references: [complaint_id], onDelete: Cascade)
  notes         String
  status_change String?
  updated_by    String? // eddva_user_id — not an FK
  updated_at    DateTime             @default(now())

  @@index([complaint_id])
  @@map("front_office_complaint_updates")
}

enum FrontOfficeAttachmentEntityType {
  visitor
  enquiry
  complaint
}

model FrontOfficeAttachment {
  attachment_id Int                             @id @default(autoincrement())
  entity_type   FrontOfficeAttachmentEntityType
  entity_id     Int
  file_name     String
  file_url      String
  mime_type     String?
  size_bytes    Int?
  uploaded_by   String? // eddva_user_id — not an FK
  uploaded_at   DateTime                        @default(now())

  @@index([entity_type, entity_id])
  @@map("front_office_attachments")
}

enum FrontOfficeNotificationEntityType {
  visitor
  enquiry
  appointment
  complaint
}

enum FrontOfficeNotificationChannel {
  sms
  email
  push
}

enum FrontOfficeNotificationStatus {
  queued
  sent
  failed
}

model FrontOfficeNotification {
  notification_id       Int                               @id @default(autoincrement())
  entity_type           FrontOfficeNotificationEntityType
  entity_id             Int
  event_type            String
  recipient_employee_id Int?
  recipient             FrontOfficeEmployee?              @relation(fields: [recipient_employee_id], references: [employee_id])
  channel               FrontOfficeNotificationChannel    @default(email)
  status                FrontOfficeNotificationStatus     @default(queued)
  message               String?
  sent_at               DateTime?
  created_at            DateTime                          @default(now())

  @@index([entity_type, entity_id])
  @@index([recipient_employee_id])
  @@map("front_office_notifications")
}

// ─── Front Office RBAC — parallel dynamic-role system, mirroring Sports/Library ───
// Independent of core User/Role/Permission: Front Office staff authenticate via
// SSO-exchange (front_office/auth) or direct username/password login, and may
// not exist as core `users` rows at all (hence no FK from these tables to `users`).

model FrontOfficeDynamicRole {
  role_id      Int      @id @default(autoincrement())
  institute_id String
  name         String
  description  String?
  permissions  Json     @default("[]")
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  user_roles FrontOfficeUserDynamicRole[]

  @@unique([institute_id, name])
  @@map("front_office_dynamic_roles")
}

model FrontOfficeUserDynamicRole {
  id            Int                    @id @default(autoincrement())
  institute_id  String
  eddva_user_id String
  user_name     String
  user_email    String?
  username      String
  password_hash String
  is_active     Boolean                @default(true)
  role_id       Int
  assigned_at   DateTime               @default(now())
  role          FrontOfficeDynamicRole @relation(fields: [role_id], references: [role_id], onDelete: Cascade)

  @@unique([institute_id, eddva_user_id])
  @@unique([institute_id, username])
  @@map("front_office_user_dynamic_roles")
}

model FrontOfficeSsoSession {
  session_id    Int      @id @default(autoincrement())
  institute_id  String
  eddva_user_id String
  user_name     String
  user_email    String?
  user_role     String
  fo_token      String   @unique
  expires_at    DateTime
  created_at    DateTime @default(now())

  @@map("front_office_sso_sessions")
}

model FrontOfficePermission {
  permission_id Int      @id @default(autoincrement())
  key           String   @unique
  resource      String
  action        String
  name          String
  category      String
  description   String?
  is_system     Boolean  @default(true)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@map("front_office_permissions_catalog")
}
