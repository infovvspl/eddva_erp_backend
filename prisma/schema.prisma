// ============================================================
// ACCOUNTS MODULE (Chart of Accounts, Vouchers, Ledger, Reports)
// Uses core RBAC (User/Role/Permission) — not a satellite RBAC.
// voucher_entries is the append-only source of truth; ledger and
// reports are read-only queries over it, never separate tables.
// ============================================================

model FinancialYear {
  id          String              @id @default(uuid())
  instituteId String?
  fyLabel     String
  startDate   DateTime
  endDate     DateTime
  status      FinancialYearStatus @default(OPEN)
  closedAt    DateTime?
  closedBy    String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  vouchers       Voucher[]
  periodBalances AccountPeriodBalance[]

  @@unique([instituteId, fyLabel])
  @@index([instituteId, status])
  @@map("financial_years")
}

model AccountGroup {
  id            String         @id @default(uuid())
  instituteId   String?
  groupName     String
  parentGroupId String?
  parentGroup   AccountGroup?  @relation("GroupHierarchy", fields: [parentGroupId], references: [id])
  childGroups   AccountGroup[] @relation("GroupHierarchy")
  nature        AccountNature
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  ledgerAccounts LedgerAccount[]

  @@unique([instituteId, groupName])
  @@index([instituteId])
  @@map("account_groups")
}

model LedgerAccount {
  id                 String       @id @default(uuid())
  instituteId        String?
  accountCode        String
  accountName        String
  groupId            String
  group              AccountGroup @relation(fields: [groupId], references: [id])
  openingBalance     Decimal      @default(0) @db.Decimal(14, 2)
  openingBalanceType BalanceType  @default(DEBIT)
  allowVoucherEntry  Boolean      @default(true)
  isActive           Boolean      @default(true)
  isCashAccount      Boolean      @default(false)
  isBankAccount      Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  voucherEntries VoucherEntry[]
  periodBalances AccountPeriodBalance[]
  mappings       AccountMapping[]

  @@unique([instituteId, accountCode])
  @@index([instituteId, isActive])
  @@index([groupId])
  @@map("ledger_accounts")
}

model CostCenter {
  id          String   @id @default(uuid())
  instituteId String?
  name        String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  voucherEntries VoucherEntry[]

  @@unique([instituteId, name])
  @@index([instituteId])
  @@map("cost_centers")
}

model VoucherType {
  id       String  @id @default(uuid())
  code     String  @unique
  name     String
  prefix   String
  isActive Boolean @default(true)

  vouchers Voucher[]

  @@map("voucher_types")
}

// FY-scoped atomic sequence for voucher numbering. Deliberately separate from
// NumberingService/number_sequences: that service derives its financial-year
// string from the document date via a fixed Apr-Mar rule, whereas Voucher
// numbers must be unique per (voucherTypeId, fyId) against this module's own
// user-managed FinancialYear entity, which need not follow that rule.
model VoucherNumberSequence {
  id            String @id @default(uuid())
  voucherTypeId String
  fyId          String
  currentNumber Int    @default(0)

  @@unique([voucherTypeId, fyId])
  @@map("voucher_number_sequences")
}

model Voucher {
  id                String        @id @default(uuid())
  instituteId       String?
  voucherNumber     String
  voucherTypeId     String
  voucherType       VoucherType   @relation(fields: [voucherTypeId], references: [id])
  fyId              String
  financialYear     FinancialYear @relation(fields: [fyId], references: [id])
  voucherDate       DateTime
  narration         String?
  referenceNo       String?
  totalDebit        Decimal       @default(0) @db.Decimal(14, 2)
  totalCredit       Decimal       @default(0) @db.Decimal(14, 2)
  status            VoucherStatus @default(DRAFT)
  isAutoPosted      Boolean       @default(false)
  sourceModule      String?
  sourceReferenceId String?
  createdBy         String
  approvedBy        String?
  postedAt          DateTime?
  cancelledAt       DateTime?
  cancelledBy       String?
  reversalOfId      String?       @unique
  reversalOf        Voucher?      @relation("VoucherReversal", fields: [reversalOfId], references: [id])
  reversedBy        Voucher?      @relation("VoucherReversal")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  entries     VoucherEntry[]
  attachments VoucherAttachment[]

  @@unique([voucherTypeId, fyId, voucherNumber])
  @@unique([sourceModule, sourceReferenceId])
  @@index([fyId, status])
  @@index([instituteId, voucherDate])
  @@map("vouchers")
}

model VoucherEntry {
  id           String        @id @default(uuid())
  voucherId    String
  voucher      Voucher       @relation(fields: [voucherId], references: [id])
  accountId    String
  account      LedgerAccount @relation(fields: [accountId], references: [id])
  debitAmount  Decimal       @default(0) @db.Decimal(14, 2)
  creditAmount Decimal       @default(0) @db.Decimal(14, 2)
  costCenterId String?
  costCenter   CostCenter?   @relation(fields: [costCenterId], references: [id])
  narration    String?
  voucherDate  DateTime
  createdAt    DateTime      @default(now())

  @@index([accountId, voucherDate])
  @@index([voucherId])
  @@index([costCenterId])
  @@map("voucher_entries")
}

model VoucherAttachment {
  id         String   @id @default(uuid())
  voucherId  String
  voucher    Voucher  @relation(fields: [voucherId], references: [id])
  fileUrl    String
  uploadedBy String
  uploadedAt DateTime @default(now())

  @@index([voucherId])
  @@map("voucher_attachments")
}

model AccountPeriodBalance {
  id                 String        @id @default(uuid())
  fyId               String
  financialYear      FinancialYear @relation(fields: [fyId], references: [id])
  accountId          String
  account            LedgerAccount @relation(fields: [accountId], references: [id])
  openingBalance     Decimal       @db.Decimal(14, 2)
  openingBalanceType BalanceType
  closingBalance     Decimal       @db.Decimal(14, 2)
  closingBalanceType BalanceType
  createdAt          DateTime      @default(now())

  @@unique([fyId, accountId])
  @@map("account_period_balances")
}

model AccountMapping {
  id          String        @id @default(uuid())
  instituteId String?
  mappingKey  String
  accountId   String
  account     LedgerAccount @relation(fields: [accountId], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([instituteId, mappingKey])
  @@map("account_mappings")
}

// Parallel dynamic-role RBAC for Accounts — same architecture as
// Library/Sports/Canteen/Front Office/Inventory/Transport: an independent
// JWT space for Accounts staff (Accounts Clerk/Accountant/Finance Admin) who
// may or may not exist as core `users` rows.
model AccountsDynamicRole {
  role_id      Int      @id @default(autoincrement())
  institute_id String
  name         String
  description  String?
  permissions  Json     @default("[]")
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  user_roles AccountsUserDynamicRole[]

  @@unique([institute_id, name])
  @@map("accounts_dynamic_roles")
}

model AccountsUserDynamicRole {
  id            Int                 @id @default(autoincrement())
  institute_id  String
  eddva_user_id String
  user_name     String
  user_email    String?
  username      String
  password_hash String
  is_active     Boolean             @default(true)
  role_id       Int
  assigned_at   DateTime            @default(now())
  role          AccountsDynamicRole @relation(fields: [role_id], references: [role_id], onDelete: Cascade)

  @@unique([institute_id, eddva_user_id])
  @@unique([institute_id, username])
  @@map("accounts_user_dynamic_roles")
}

model AccountsSsoSession {
  session_id    Int      @id @default(autoincrement())
  institute_id  String
  eddva_user_id String
  user_name     String
  user_email    String?
  user_role     String
  acc_token     String   @unique
  expires_at    DateTime
  created_at    DateTime @default(now())

  @@map("accounts_sso_sessions")
}

model AccountsPermission {
  permission_id Int      @id @default(autoincrement())
  key           String   @unique
  resource      String
  action        String
  name          String
  category      String
  description   String?
  is_system     Boolean  @default(true)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@map("accounts_permissions_catalog")
}

// ─────────────────────────────────────────────────────────────────────────
// Sales & Purchase Management Module
// Masters (vendors/customers/items/item categories/UOM/tax codes/payment
// terms/warehouses) → Purchase (PO → approval → GRN → Purchase Invoice,
// three-way matched → Purchase Payment) → Sales (Sales Order → Sales
// Invoice → Sales Receipt) → read-only Purchase/Sales Registers (queries
// over posted invoices — never separate tables).
//
// RBAC is the same parallel dynamic-role architecture as Front Office/
// Inventory/Transport (independent JWT, SSO exchange + direct login,
// dynamic roles with a live resource:action permission catalog). Top-level
// masters and documents carry institute_id, mirroring Transport's
// multi-tenant scoping (chosen over Inventory's single-tenant style since
// these are per-institute financial records).
//
// Financial-year-aware document numbering reuses the core NumberingService
// (number_sequences / DocumentType) rather than a parallel mechanism.
// Deliberately does NOT FK into Accounts' FinancialYear model — each RBAC
// island (Accounts included) stays independent, so financial_year columns
// below store the same FY label string NumberingService already derives
// (e.g. "2026-27") rather than a cross-module foreign key.
// ─────────────────────────────────────────────────────────────────────────

enum SpPartyStatus {
  ACTIVE
  INACTIVE
  BLACKLISTED
}

enum SpPaymentMode {
  CASH
  BANK_TRANSFER
  UPI
  CHEQUE
  CARD
  OTHER
}

enum SpItemStatus {
  ACTIVE
  INACTIVE
}

enum SpPoStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PARTIALLY_RECEIVED
  CLOSED
  CANCELLED
}

enum SpPoApprovalAction {
  APPROVED
  REJECTED
}

enum SpGrnStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum SpInvoiceStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum SpPaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum SpSoStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_INVOICED
  CLOSED
  CANCELLED
}

model SpVendor {
  vendor_id       Int            @id @default(autoincrement())
  institute_id    String
  vendor_code     String
  vendor_name     String
  gstin           String?
  tax_id          String?
  address_line1   String?
  address_line2   String?
  city            String?
  state           String?
  pincode         String?
  payment_term_id Int?
  payment_term    SpPaymentTerm? @relation(fields: [payment_term_id], references: [payment_term_id])
  credit_limit    Decimal        @default(0) @db.Decimal(14, 2)
  status          SpPartyStatus  @default(ACTIVE)
  created_by      String?
  updated_by      String?
  deleted_at      DateTime?
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt

  contacts          SpVendorContact[]
  bank_details      SpVendorBankDetail[]
  purchase_orders   SpPurchaseOrder[]
  grns              SpGrn[]
  purchase_invoices SpPurchaseInvoice[]

  @@unique([institute_id, vendor_code])
  @@index([institute_id, status])
  @@index([vendor_name])
  @@index([gstin])
  @@map("sp_vendors")
}

model SpVendorContact {
  contact_id  Int      @id @default(autoincrement())
  vendor_id   Int
  vendor      SpVendor @relation(fields: [vendor_id], references: [vendor_id], onDelete: Cascade)
  name        String
  designation String?
  phone       String?
  email       String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@index([vendor_id])
  @@map("sp_vendor_contacts")
}

model SpVendorBankDetail {
  bank_id    Int      @id @default(autoincrement())
  vendor_id  Int
  vendor     SpVendor @relation(fields: [vendor_id], references: [vendor_id], onDelete: Cascade)
  account_no String
  ifsc       String?
  swift      String?
  bank_name  String
  is_primary Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([vendor_id])
  @@map("sp_vendor_bank_details")
}

model SpCustomer {
  customer_id     Int            @id @default(autoincrement())
  institute_id    String
  customer_code   String
  customer_name   String
  gstin           String?
  tax_id          String?
  address_line1   String?
  address_line2   String?
  city            String?
  state           String?
  pincode         String?
  payment_term_id Int?
  payment_term    SpPaymentTerm? @relation(fields: [payment_term_id], references: [payment_term_id])
  credit_limit    Decimal        @default(0) @db.Decimal(14, 2)
  status          SpPartyStatus  @default(ACTIVE)
  created_by      String?
  updated_by      String?
  deleted_at      DateTime?
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt

  contacts       SpCustomerContact[]
  sales_orders   SpSalesOrder[]
  sales_invoices SpSalesInvoice[]

  @@unique([institute_id, customer_code])
  @@index([institute_id, status])
  @@index([customer_name])
  @@index([gstin])
  @@map("sp_customers")
}

model SpCustomerContact {
  contact_id  Int        @id @default(autoincrement())
  customer_id Int
  customer    SpCustomer @relation(fields: [customer_id], references: [customer_id], onDelete: Cascade)
  name        String
  designation String?
  phone       String?
  email       String?
  created_at  DateTime   @default(now())
  updated_at  DateTime   @updatedAt

  @@index([customer_id])
  @@map("sp_customer_contacts")
}

model SpItemCategory {
  category_id  Int      @id @default(autoincrement())
  institute_id String
  name         String
  status       Status   @default(ACTIVE)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  items SpItem[]

  @@unique([institute_id, name])
  @@map("sp_item_categories")
}

model SpUom {
  uom_id       Int      @id @default(autoincrement())
  institute_id String
  name         String
  symbol       String
  status       Status   @default(ACTIVE)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  items SpItem[]

  @@unique([institute_id, name])
  @@map("sp_uoms")
}

// Tax codes are versioned, never edited in place once used — a rate change
// creates a new row with a later effective_from instead of mutating the old
// one. Transaction lines always snapshot their own rates/amounts regardless,
// so historical documents never depend on this table's current contents.
model SpTaxCode {
  tax_code_id    Int      @id @default(autoincrement())
  institute_id   String
  name           String
  cgst_pct       Decimal  @default(0) @db.Decimal(5, 2)
  sgst_pct       Decimal  @default(0) @db.Decimal(5, 2)
  igst_pct       Decimal  @default(0) @db.Decimal(5, 2)
  effective_from DateTime @db.Date
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now())
  created_by     String?

  items    SpItem[]
  po_items SpPurchaseOrderItem[]
  so_items SpSalesOrderItem[]

  @@index([institute_id, name, effective_from])
  @@map("sp_tax_codes")
}

model SpPaymentTerm {
  payment_term_id Int      @id @default(autoincrement())
  institute_id    String
  term_name       String
  days            Int
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  vendors   SpVendor[]
  customers SpCustomer[]

  @@unique([institute_id, term_name])
  @@map("sp_payment_terms")
}

model SpWarehouse {
  warehouse_id Int      @id @default(autoincrement())
  institute_id String
  name         String
  address      String?
  is_default   Boolean  @default(false)
  status       Status   @default(ACTIVE)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  purchase_orders SpPurchaseOrder[]
  grns            SpGrn[]

  @@unique([institute_id, name])
  @@map("sp_warehouses")
}

model SpItem {
  item_id        Int            @id @default(autoincrement())
  institute_id   String
  item_code      String
  item_name      String
  category_id    Int
  category       SpItemCategory @relation(fields: [category_id], references: [category_id])
  uom_id         Int
  uom            SpUom          @relation(fields: [uom_id], references: [uom_id])
  hsn_sac_code   String?
  purchase_price Decimal        @default(0) @db.Decimal(14, 2)
  sales_price    Decimal        @default(0) @db.Decimal(14, 2)
  tax_code_id    Int?
  tax_code       SpTaxCode?     @relation(fields: [tax_code_id], references: [tax_code_id])
  status         SpItemStatus   @default(ACTIVE)
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt

  po_items  SpPurchaseOrderItem[]
  grn_items SpGrnItem[]
  pi_items  SpPurchaseInvoiceItem[]
  so_items  SpSalesOrderItem[]
  si_items  SpSalesInvoiceItem[]

  @@unique([institute_id, item_code])
  @@index([institute_id, status])
  @@index([item_name])
  @@map("sp_items")
}

model SpPurchaseOrder {
  po_id                  Int         @id @default(autoincrement())
  institute_id           String
  po_number              String
  financial_year         String
  vendor_id              Int
  vendor                 SpVendor    @relation(fields: [vendor_id], references: [vendor_id])
  po_date                DateTime    @db.Date
  expected_delivery_date DateTime?   @db.Date
  warehouse_id           Int
  warehouse              SpWarehouse @relation(fields: [warehouse_id], references: [warehouse_id])
  status                 SpPoStatus  @default(DRAFT)
  subtotal               Decimal     @default(0) @db.Decimal(14, 2)
  tax_amount             Decimal     @default(0) @db.Decimal(14, 2)
  discount               Decimal     @default(0) @db.Decimal(14, 2)
  grand_total            Decimal     @default(0) @db.Decimal(14, 2)
  created_by             String
  submitted_at           DateTime?
  approved_by            String?
  approved_at            DateTime?
  rejected_by            String?
  rejected_at            DateTime?
  rejection_reason       String?
  cancelled_by           String?
  cancelled_at           DateTime?
  created_at             DateTime    @default(now())
  updated_at             DateTime    @updatedAt

  items             SpPurchaseOrderItem[]
  approvals         SpPoApproval[]
  grns              SpGrn[]
  purchase_invoices SpPurchaseInvoice[]

  @@unique([institute_id, po_number])
  @@index([institute_id, status])
  @@index([vendor_id])
  @@index([po_date])
  @@map("sp_purchase_orders")
}

model SpPurchaseOrderItem {
  po_item_id        Int             @id @default(autoincrement())
  purchase_order_id Int
  purchase_order    SpPurchaseOrder @relation(fields: [purchase_order_id], references: [po_id], onDelete: Cascade)
  item_id           Int
  item              SpItem          @relation(fields: [item_id], references: [item_id])
  quantity          Decimal         @db.Decimal(14, 3)
  unit_price        Decimal         @db.Decimal(14, 2)
  tax_code_id       Int?
  tax_code          SpTaxCode?      @relation(fields: [tax_code_id], references: [tax_code_id])
  line_discount     Decimal         @default(0) @db.Decimal(14, 2)
  line_tax_amount   Decimal         @default(0) @db.Decimal(14, 2)
  line_total        Decimal         @default(0) @db.Decimal(14, 2)
  received_qty      Decimal         @default(0) @db.Decimal(14, 3)
  created_at        DateTime        @default(now())
  updated_at        DateTime        @updatedAt

  grn_items SpGrnItem[]
  pi_items  SpPurchaseInvoiceItem[]

  @@index([purchase_order_id])
  @@index([item_id])
  @@map("sp_purchase_order_items")
}

model SpPoApproval {
  approval_id Int                @id @default(autoincrement())
  po_id       Int
  po          SpPurchaseOrder    @relation(fields: [po_id], references: [po_id], onDelete: Cascade)
  approver_id String
  action      SpPoApprovalAction
  remarks     String?
  action_at   DateTime           @default(now())

  @@index([po_id])
  @@map("sp_po_approvals")
}

// Configurable approval thresholds (section 21/22 of the module spec) —
// amount bands optionally tied to a required approver role, evaluated in
// `sequence` order so a very large PO can require multiple sign-offs. Never
// hardcoded in application logic.
model SpApprovalRule {
  rule_id          Int                       @id @default(autoincrement())
  institute_id     String
  name             String
  min_amount       Decimal                   @default(0) @db.Decimal(14, 2)
  max_amount       Decimal?                  @db.Decimal(14, 2)
  approver_role_id Int?
  approver_role    SalesPurchaseDynamicRole? @relation(fields: [approver_role_id], references: [role_id])
  sequence         Int                       @default(1)
  is_active        Boolean                   @default(true)
  created_at       DateTime                  @default(now())
  updated_at       DateTime                  @updatedAt

  @@index([institute_id, is_active, min_amount])
  @@map("sp_approval_rules")
}

model SpGrn {
  grn_id            Int             @id @default(autoincrement())
  institute_id      String
  grn_number        String
  financial_year    String
  purchase_order_id Int
  purchase_order    SpPurchaseOrder @relation(fields: [purchase_order_id], references: [po_id])
  vendor_id         Int
  vendor            SpVendor        @relation(fields: [vendor_id], references: [vendor_id])
  received_date     DateTime        @db.Date
  warehouse_id      Int
  warehouse         SpWarehouse     @relation(fields: [warehouse_id], references: [warehouse_id])
  status            SpGrnStatus     @default(DRAFT)
  created_by        String
  cancelled_by      String?
  cancelled_at      DateTime?
  created_at        DateTime        @default(now())
  updated_at        DateTime        @updatedAt

  items             SpGrnItem[]
  purchase_invoices SpPurchaseInvoice[]

  @@unique([institute_id, grn_number])
  @@index([institute_id, status])
  @@index([purchase_order_id])
  @@index([vendor_id])
  @@map("sp_grns")
}

model SpGrnItem {
  grn_item_id  Int                 @id @default(autoincrement())
  grn_id       Int
  grn          SpGrn               @relation(fields: [grn_id], references: [grn_id], onDelete: Cascade)
  po_item_id   Int
  po_item      SpPurchaseOrderItem @relation(fields: [po_item_id], references: [po_item_id])
  item_id      Int
  item         SpItem              @relation(fields: [item_id], references: [item_id])
  received_qty Decimal             @db.Decimal(14, 3)
  accepted_qty Decimal             @db.Decimal(14, 3)
  rejected_qty Decimal             @default(0) @db.Decimal(14, 3)
  created_at   DateTime            @default(now())

  pi_items SpPurchaseInvoiceItem[]

  @@index([grn_id])
  @@index([po_item_id])
  @@map("sp_grn_items")
}

model SpPurchaseInvoice {
  pi_id                 Int              @id @default(autoincrement())
  institute_id          String
  invoice_number        String
  financial_year        String
  vendor_invoice_number String
  vendor_id             Int
  vendor                SpVendor         @relation(fields: [vendor_id], references: [vendor_id])
  purchase_order_id     Int?
  purchase_order        SpPurchaseOrder? @relation(fields: [purchase_order_id], references: [po_id])
  grn_id                Int?
  grn                   SpGrn?           @relation(fields: [grn_id], references: [grn_id])
  invoice_date          DateTime         @db.Date
  due_date              DateTime?        @db.Date
  subtotal              Decimal          @default(0) @db.Decimal(14, 2)
  tax_amount            Decimal          @default(0) @db.Decimal(14, 2)
  discount              Decimal          @default(0) @db.Decimal(14, 2)
  grand_total           Decimal          @default(0) @db.Decimal(14, 2)
  paid_amount           Decimal          @default(0) @db.Decimal(14, 2)
  payment_status        SpPaymentStatus  @default(UNPAID)
  status                SpInvoiceStatus  @default(DRAFT)
  created_by            String
  posted_by             String?
  posted_at             DateTime?
  cancelled_by          String?
  cancelled_at          DateTime?
  created_at            DateTime         @default(now())
  updated_at            DateTime         @updatedAt

  items    SpPurchaseInvoiceItem[]
  payments SpPurchasePayment[]

  @@unique([institute_id, invoice_number])
  @@index([institute_id, status, invoice_date])
  @@index([vendor_id])
  @@index([purchase_order_id])
  @@index([grn_id])
  @@index([vendor_invoice_number])
  @@map("sp_purchase_invoices")
}

// Snapshot of commercial/tax values at posting time — later changes to
// SpItem price, SpTaxCode rates, or the item master must never alter these.
model SpPurchaseInvoiceItem {
  pi_item_id    Int                  @id @default(autoincrement())
  pi_id         Int
  invoice       SpPurchaseInvoice    @relation(fields: [pi_id], references: [pi_id], onDelete: Cascade)
  po_item_id    Int?
  po_item       SpPurchaseOrderItem? @relation(fields: [po_item_id], references: [po_item_id])
  grn_item_id   Int?
  grn_item      SpGrnItem?           @relation(fields: [grn_item_id], references: [grn_item_id])
  item_id       Int
  item          SpItem               @relation(fields: [item_id], references: [item_id])
  quantity      Decimal              @db.Decimal(14, 3)
  unit_price    Decimal              @db.Decimal(14, 2)
  cgst_rate     Decimal              @default(0) @db.Decimal(5, 2)
  sgst_rate     Decimal              @default(0) @db.Decimal(5, 2)
  igst_rate     Decimal              @default(0) @db.Decimal(5, 2)
  cgst_amount   Decimal              @default(0) @db.Decimal(14, 2)
  sgst_amount   Decimal              @default(0) @db.Decimal(14, 2)
  igst_amount   Decimal              @default(0) @db.Decimal(14, 2)
  line_discount Decimal              @default(0) @db.Decimal(14, 2)
  line_total    Decimal              @default(0) @db.Decimal(14, 2)

  @@index([pi_id])
  @@index([item_id])
  @@map("sp_purchase_invoice_items")
}

model SpPurchasePayment {
  payment_id   Int               @id @default(autoincrement())
  institute_id String
  pi_id        Int
  invoice      SpPurchaseInvoice @relation(fields: [pi_id], references: [pi_id])
  payment_date DateTime          @db.Date
  amount       Decimal           @db.Decimal(14, 2)
  mode         SpPaymentMode
  reference_no String?
  created_by   String
  created_at   DateTime          @default(now())
  updated_at   DateTime          @updatedAt

  @@index([pi_id])
  @@index([institute_id, payment_date])
  @@map("sp_purchase_payments")
}

model SpSalesOrder {
  so_id          Int        @id @default(autoincrement())
  institute_id   String
  so_number      String
  financial_year String
  customer_id    Int
  customer       SpCustomer @relation(fields: [customer_id], references: [customer_id])
  so_date        DateTime   @db.Date
  delivery_date  DateTime?  @db.Date
  status         SpSoStatus @default(DRAFT)
  subtotal       Decimal    @default(0) @db.Decimal(14, 2)
  tax_amount     Decimal    @default(0) @db.Decimal(14, 2)
  discount       Decimal    @default(0) @db.Decimal(14, 2)
  grand_total    Decimal    @default(0) @db.Decimal(14, 2)
  created_by     String
  confirmed_at   DateTime?
  cancelled_by   String?
  cancelled_at   DateTime?
  created_at     DateTime   @default(now())
  updated_at     DateTime   @updatedAt

  items          SpSalesOrderItem[]
  sales_invoices SpSalesInvoice[]

  @@unique([institute_id, so_number])
  @@index([institute_id, status])
  @@index([customer_id])
  @@index([so_date])
  @@map("sp_sales_orders")
}

model SpSalesOrderItem {
  so_item_id      Int          @id @default(autoincrement())
  sales_order_id  Int
  sales_order     SpSalesOrder @relation(fields: [sales_order_id], references: [so_id], onDelete: Cascade)
  item_id         Int
  item            SpItem       @relation(fields: [item_id], references: [item_id])
  quantity        Decimal      @db.Decimal(14, 3)
  unit_price      Decimal      @db.Decimal(14, 2)
  tax_code_id     Int?
  tax_code        SpTaxCode?   @relation(fields: [tax_code_id], references: [tax_code_id])
  line_discount   Decimal      @default(0) @db.Decimal(14, 2)
  line_tax_amount Decimal      @default(0) @db.Decimal(14, 2)
  line_total      Decimal      @default(0) @db.Decimal(14, 2)
  invoiced_qty    Decimal      @default(0) @db.Decimal(14, 3)
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  si_items SpSalesInvoiceItem[]

  @@index([sales_order_id])
  @@index([item_id])
  @@map("sp_sales_order_items")
}

model SpSalesInvoice {
  si_id          Int             @id @default(autoincrement())
  institute_id   String
  invoice_number String
  financial_year String
  customer_id    Int
  customer       SpCustomer      @relation(fields: [customer_id], references: [customer_id])
  sales_order_id Int?
  sales_order    SpSalesOrder?   @relation(fields: [sales_order_id], references: [so_id])
  invoice_date   DateTime        @db.Date
  due_date       DateTime?       @db.Date
  subtotal       Decimal         @default(0) @db.Decimal(14, 2)
  tax_amount     Decimal         @default(0) @db.Decimal(14, 2)
  discount       Decimal         @default(0) @db.Decimal(14, 2)
  grand_total    Decimal         @default(0) @db.Decimal(14, 2)
  paid_amount    Decimal         @default(0) @db.Decimal(14, 2)
  payment_status SpPaymentStatus @default(UNPAID)
  status         SpInvoiceStatus @default(DRAFT)
  created_by     String
  posted_by      String?
  posted_at      DateTime?
  cancelled_by   String?
  cancelled_at   DateTime?
  created_at     DateTime        @default(now())
  updated_at     DateTime        @updatedAt

  items    SpSalesInvoiceItem[]
  receipts SpSalesReceipt[]

  @@unique([institute_id, invoice_number])
  @@index([institute_id, status, invoice_date])
  @@index([customer_id])
  @@index([sales_order_id])
  @@map("sp_sales_invoices")
}

model SpSalesInvoiceItem {
  si_item_id    Int               @id @default(autoincrement())
  si_id         Int
  invoice       SpSalesInvoice    @relation(fields: [si_id], references: [si_id], onDelete: Cascade)
  so_item_id    Int?
  so_item       SpSalesOrderItem? @relation(fields: [so_item_id], references: [so_item_id])
  item_id       Int
  item          SpItem            @relation(fields: [item_id], references: [item_id])
  quantity      Decimal           @db.Decimal(14, 3)
  unit_price    Decimal           @db.Decimal(14, 2)
  cgst_rate     Decimal           @default(0) @db.Decimal(5, 2)
  sgst_rate     Decimal           @default(0) @db.Decimal(5, 2)
  igst_rate     Decimal           @default(0) @db.Decimal(5, 2)
  cgst_amount   Decimal           @default(0) @db.Decimal(14, 2)
  sgst_amount   Decimal           @default(0) @db.Decimal(14, 2)
  igst_amount   Decimal           @default(0) @db.Decimal(14, 2)
  line_discount Decimal           @default(0) @db.Decimal(14, 2)
  line_total    Decimal           @default(0) @db.Decimal(14, 2)

  @@index([si_id])
  @@index([item_id])
  @@map("sp_sales_invoice_items")
}

model SpSalesReceipt {
  receipt_id   Int            @id @default(autoincrement())
  institute_id String
  si_id        Int
  invoice      SpSalesInvoice @relation(fields: [si_id], references: [si_id])
  receipt_date DateTime       @db.Date
  amount       Decimal        @db.Decimal(14, 2)
  mode         SpPaymentMode
  reference_no String?
  created_by   String
  created_at   DateTime       @default(now())
  updated_at   DateTime       @updatedAt

  @@index([si_id])
  @@index([institute_id, receipt_date])
  @@map("sp_sales_receipts")
}

// ─── Sales & Purchase RBAC — parallel dynamic-role system, same architecture as Front Office/Inventory/Transport ───

model SalesPurchaseDynamicRole {
  role_id      Int      @id @default(autoincrement())
  institute_id String
  name         String
  description  String?
  permissions  Json     @default("[]")
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  user_roles     SalesPurchaseUserDynamicRole[]
  approval_rules SpApprovalRule[]

  @@unique([institute_id, name])
  @@map("sales_purchase_dynamic_roles")
}

model SalesPurchaseUserDynamicRole {
  id            Int                      @id @default(autoincrement())
  institute_id  String
  eddva_user_id String
  user_name     String
  user_email    String?
  username      String
  password_hash String
  is_active     Boolean                  @default(true)
  role_id       Int
  assigned_at   DateTime                 @default(now())
  role          SalesPurchaseDynamicRole @relation(fields: [role_id], references: [role_id], onDelete: Cascade)

  @@unique([institute_id, eddva_user_id])
  @@unique([institute_id, username])
  @@map("sales_purchase_user_dynamic_roles")
}

model SalesPurchaseSsoSession {
  session_id    Int      @id @default(autoincrement())
  institute_id  String
  eddva_user_id String
  user_name     String
  user_email    String?
  user_role     String
  sp_token      String   @unique
  expires_at    DateTime
  created_at    DateTime @default(now())

  @@map("sales_purchase_sso_sessions")
}

model SalesPurchasePermission {
  permission_id Int      @id @default(autoincrement())
  key           String   @unique
  resource      String
  action        String
  name          String
  category      String
  description   String?
  is_system     Boolean  @default(true)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@map("sales_purchase_permissions_catalog")
}
// ═══════════════════════════════════════════════════════════════════════════
// Admission Management
// Funnel: Enquiry → Application → Test/Interview → Merit List → Offer →
//         Admission Fee → Confirmed Admission.
// `AdmissionApplication.status` is the single authoritative pipeline state.
// ═══════════════════════════════════════════════════════════════════════════

enum AdmissionSessionStatus {
  upcoming
  active
  closed
}

enum AdmissionGender {
  male
  female
  other
}

enum AdmissionEnquirySource {
  walk_in
  website
  referral
  agent
  advertisement
}

enum AdmissionEnquiryStatus {
  new
  contacted
  application_started
  converted
  lost
}

enum AdmissionApplicationStatus {
  draft
  submitted
  under_review
  test_scheduled
  shortlisted
  waitlisted
  rejected
  offered
  admitted
  cancelled
}

enum AdmissionDocumentType {
  birth_certificate
  previous_marksheet
  transfer_certificate
  id_proof
  photo
  other
}

enum AdmissionVerificationStatus {
  pending
  verified
  rejected
}

enum AdmissionPaymentMode {
  card
  upi
  bank_transfer
  cash
}

enum AdmissionFeePaymentStatus {
  success
  pending
  failed
}

enum AdmissionTestMode {
  online
  offline
}

enum AdmissionTestRegistrationStatus {
  registered
  appeared
  absent
}

enum AdmissionInterviewMode {
  online
  offline
}

enum AdmissionInterviewStatus {
  scheduled
  completed
  no_show
  rescheduled
}

enum AdmissionRecommendation {
  recommend
  not_recommend
  waitlist
}

enum AdmissionMeritOutcome {
  selected
  waitlisted
  not_selected
}

enum AdmissionOfferStatus {
  offered
  accepted
  declined
  expired
}

enum AdmissionConfirmationStatus {
  confirmed
  cancelled
}

/// Whether the downstream core Student record has been created for a confirmed admission.
enum AdmissionStudentLinkStatus {
  pending
  linked
}

enum AdmissionNotificationChannel {
  email
  sms
}

enum AdmissionNotificationStatus {
  queued
  sent
  failed
}

model AdmissionAcademicSession {
  session_id   Int                    @id @default(autoincrement())
  institute_id String
  name         String
  start_date   DateTime               @db.Date
  end_date     DateTime               @db.Date
  status       AdmissionSessionStatus @default(upcoming)
  created_by   String?
  created_at   DateTime               @default(now())
  updated_at   DateTime               @updatedAt
  deleted_at   DateTime?

  applications   AdmissionApplication[]
  tests          AdmissionEntranceTest[]
  merit_lists    AdmissionMeritList[]
  fee_structures AdmissionFeeStructure[]

  @@index([institute_id, status])
  @@index([institute_id, name])
  @@map("admission_academic_sessions")
}

model AdmissionProgram {
  program_id           Int       @id @default(autoincrement())
  institute_id         String
  name                 String
  level                String
  total_seats          Int       @default(0)
  eligibility_criteria String?
  created_by           String?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt
  deleted_at           DateTime?

  enquiries      AdmissionEnquiry[]
  applications   AdmissionApplication[]
  tests          AdmissionEntranceTest[]
  merit_lists    AdmissionMeritList[]
  fee_structures AdmissionFeeStructure[]

  @@index([institute_id, name])
  @@map("admission_programs")
}

/// The person. One applicant can hold many applications (different programs/sessions).
model AdmissionApplicant {
  applicant_id     Int              @id @default(autoincrement())
  institute_id     String
  name             String
  dob              DateTime?        @db.Date
  gender           AdmissionGender?
  email            String?
  phone            String
  address          String?
  guardian_name    String?
  guardian_contact String?
  photo_url        String?
  created_by       String?
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt
  deleted_at       DateTime?

  applications AdmissionApplication[]

  @@index([institute_id, phone])
  @@index([institute_id, email])
  @@index([institute_id, name])
  @@map("admission_applicants")
}

model AdmissionEnquiry {
  enquiry_id   Int                    @id @default(autoincrement())
  institute_id String
  name         String
  phone        String
  email        String?
  program_id   Int?
  program      AdmissionProgram?      @relation(fields: [program_id], references: [program_id])
  source       AdmissionEnquirySource
  status       AdmissionEnquiryStatus @default(new)
  assigned_to  String? // eddva_user_id of an assigned admission staff member — not an FK
  created_by   String?
  created_at   DateTime               @default(now())
  updated_at   DateTime               @updatedAt
  deleted_at   DateTime?

  followups   AdmissionEnquiryFollowup[]
  application AdmissionApplication?

  @@index([institute_id, status])
  @@index([institute_id, assigned_to, status])
  @@index([institute_id, program_id])
  @@index([institute_id, created_at])
  @@map("admission_enquiries")
}

model AdmissionEnquiryFollowup {
  followup_id        Int              @id @default(autoincrement())
  enquiry_id         Int
  enquiry            AdmissionEnquiry @relation(fields: [enquiry_id], references: [enquiry_id], onDelete: Cascade)
  notes              String
  followup_date      DateTime         @db.Date
  next_followup_date DateTime?        @db.Date
  updated_by         String
  created_at         DateTime         @default(now())
  updated_at         DateTime         @updatedAt

  @@index([enquiry_id, followup_date])
  @@index([next_followup_date])
  @@map("admission_enquiry_followups")
}

model AdmissionApplication {
  application_id     Int                        @id @default(autoincrement())
  institute_id       String
  applicant_id       Int
  applicant          AdmissionApplicant         @relation(fields: [applicant_id], references: [applicant_id])
  session_id         Int
  session            AdmissionAcademicSession   @relation(fields: [session_id], references: [session_id])
  program_id         Int
  program            AdmissionProgram           @relation(fields: [program_id], references: [program_id])
  application_number String                     @unique
  source_enquiry_id  Int?                       @unique
  source_enquiry     AdmissionEnquiry?          @relation(fields: [source_enquiry_id], references: [enquiry_id])
  application_date   DateTime                   @db.Date
  status             AdmissionApplicationStatus @default(draft)
  created_by         String?
  created_at         DateTime                   @default(now())
  updated_at         DateTime                   @updatedAt
  deleted_at         DateTime?

  documents          AdmissionApplicationDocument[]
  fee_payments       AdmissionApplicationFeePayment[]
  test_registrations AdmissionTestRegistration[]
  test_results       AdmissionTestResult[]
  interview          AdmissionInterview?
  merit_entries      AdmissionMeritListEntry[]
  offer              AdmissionOffer?
  payments           AdmissionPayment[]
  confirmation       AdmissionConfirmation?

  @@index([institute_id, session_id, program_id, status])
  @@index([institute_id, status])
  @@index([institute_id, application_date])
  @@index([applicant_id])
  @@map("admission_applications")
}

model AdmissionApplicationDocument {
  document_id         Int                         @id @default(autoincrement())
  application_id      Int
  application         AdmissionApplication        @relation(fields: [application_id], references: [application_id], onDelete: Cascade)
  document_type       AdmissionDocumentType
  file_name           String
  file_url            String
  mime_type           String
  size_bytes          Int
  verification_status AdmissionVerificationStatus @default(pending)
  verified_by         String?
  verified_at         DateTime?
  rejection_reason    String?
  uploaded_by         String?
  uploaded_at         DateTime                    @default(now())

  @@index([application_id, document_type])
  @@index([verification_status])
  @@map("admission_application_documents")
}

model AdmissionApplicationFeePayment {
  payment_id      Int                       @id @default(autoincrement())
  application_id  Int
  application     AdmissionApplication      @relation(fields: [application_id], references: [application_id], onDelete: Cascade)
  amount          Decimal                   @db.Decimal(12, 2)
  payment_date    DateTime                  @db.Date
  payment_mode    AdmissionPaymentMode
  transaction_ref String?
  status          AdmissionFeePaymentStatus
  idempotency_key String?
  recorded_by     String?
  created_at      DateTime                  @default(now())
  updated_at      DateTime                  @updatedAt

  @@unique([application_id, idempotency_key])
  @@index([application_id, status])
  @@map("admission_application_fee_payments")
}

model AdmissionEntranceTest {
  test_id      Int                      @id @default(autoincrement())
  institute_id String
  name         String
  session_id   Int
  session      AdmissionAcademicSession @relation(fields: [session_id], references: [session_id])
  program_id   Int
  program      AdmissionProgram         @relation(fields: [program_id], references: [program_id])
  test_date    DateTime
  mode         AdmissionTestMode
  venue        String?
  max_marks    Decimal                  @db.Decimal(7, 2)
  created_by   String?
  created_at   DateTime                 @default(now())
  updated_at   DateTime                 @updatedAt
  deleted_at   DateTime?

  registrations AdmissionTestRegistration[]
  results       AdmissionTestResult[]

  @@index([institute_id, session_id, program_id])
  @@index([institute_id, test_date])
  @@map("admission_entrance_tests")
}

model AdmissionTestRegistration {
  registration_id    Int                             @id @default(autoincrement())
  application_id     Int
  application        AdmissionApplication            @relation(fields: [application_id], references: [application_id], onDelete: Cascade)
  test_id            Int
  test               AdmissionEntranceTest           @relation(fields: [test_id], references: [test_id], onDelete: Cascade)
  hall_ticket_number String                          @unique
  status             AdmissionTestRegistrationStatus @default(registered)
  registered_by      String?
  created_at         DateTime                        @default(now())
  updated_at         DateTime                        @updatedAt

  @@unique([application_id, test_id])
  @@index([test_id, status])
  @@map("admission_test_registrations")
}

model AdmissionTestResult {
  result_id      Int                   @id @default(autoincrement())
  application_id Int
  application    AdmissionApplication  @relation(fields: [application_id], references: [application_id], onDelete: Cascade)
  test_id        Int
  test           AdmissionEntranceTest @relation(fields: [test_id], references: [test_id], onDelete: Cascade)
  marks_obtained Decimal               @db.Decimal(7, 2)
  rank           Int?
  recorded_by    String?
  created_at     DateTime              @default(now())
  updated_at     DateTime              @updatedAt

  @@unique([application_id, test_id])
  @@index([test_id, rank])
  @@map("admission_test_results")
}

model AdmissionInterview {
  interview_id       Int                      @id @default(autoincrement())
  application_id     Int                      @unique
  application        AdmissionApplication     @relation(fields: [application_id], references: [application_id], onDelete: Cascade)
  scheduled_datetime DateTime
  mode               AdmissionInterviewMode
  venue_or_link      String?
  status             AdmissionInterviewStatus @default(scheduled)
  created_by         String?
  created_at         DateTime                 @default(now())
  updated_at         DateTime                 @updatedAt

  panelists   AdmissionInterviewPanelist[]
  evaluations AdmissionInterviewEvaluation[]

  @@index([status, scheduled_datetime])
  @@map("admission_interviews")
}

/// Evaluators assigned to an interview. When a panel exists only its members may submit an evaluation.
model AdmissionInterviewPanelist {
  panelist_id  Int                @id @default(autoincrement())
  interview_id Int
  interview    AdmissionInterview @relation(fields: [interview_id], references: [interview_id], onDelete: Cascade)
  evaluator_id String // eddva_user_id — not an FK
  created_at   DateTime           @default(now())

  @@unique([interview_id, evaluator_id])
  @@index([evaluator_id])
  @@map("admission_interview_panelists")
}

model AdmissionInterviewEvaluation {
  evaluation_id  Int                     @id @default(autoincrement())
  interview_id   Int
  interview      AdmissionInterview      @relation(fields: [interview_id], references: [interview_id], onDelete: Cascade)
  evaluator_id   String // eddva_user_id — not an FK
  evaluator_name String?
  score          Decimal                 @db.Decimal(5, 2)
  remarks        String?
  recommendation AdmissionRecommendation
  created_at     DateTime                @default(now())

  @@unique([interview_id, evaluator_id])
  @@map("admission_interview_evaluations")
}

model AdmissionMeritList {
  merit_list_id        Int                      @id @default(autoincrement())
  institute_id         String
  name                 String?
  session_id           Int
  session              AdmissionAcademicSession @relation(fields: [session_id], references: [session_id])
  program_id           Int
  program              AdmissionProgram         @relation(fields: [program_id], references: [program_id])
  criteria_description String
  published_date       DateTime? // null = draft; set once, on publish
  published_by         String?
  created_by           String?
  created_at           DateTime                 @default(now())
  updated_at           DateTime                 @updatedAt
  deleted_at           DateTime?

  entries AdmissionMeritListEntry[]

  @@index([institute_id, session_id, program_id])
  @@map("admission_merit_lists")
}

model AdmissionMeritListEntry {
  entry_id       Int                   @id @default(autoincrement())
  merit_list_id  Int
  merit_list     AdmissionMeritList    @relation(fields: [merit_list_id], references: [merit_list_id], onDelete: Cascade)
  application_id Int
  application    AdmissionApplication  @relation(fields: [application_id], references: [application_id])
  rank           Int
  category       String
  outcome        AdmissionMeritOutcome

  @@unique([merit_list_id, application_id])
  @@unique([merit_list_id, rank])
  @@index([application_id])
  @@map("admission_merit_list_entries")
}

model AdmissionOffer {
  offer_id          Int                  @id @default(autoincrement())
  application_id    Int                  @unique
  application       AdmissionApplication @relation(fields: [application_id], references: [application_id], onDelete: Cascade)
  offer_date        DateTime
  offer_expiry_date DateTime
  status            AdmissionOfferStatus @default(offered)
  seat_category     String
  issued_by         String?
  responded_by      String?
  responded_at      DateTime?
  response_note     String?
  created_at        DateTime             @default(now())
  updated_at        DateTime             @updatedAt

  @@index([status, offer_expiry_date])
  @@map("admission_offers")
}

model AdmissionFeeStructure {
  fee_structure_id Int                      @id @default(autoincrement())
  institute_id     String
  program_id       Int
  program          AdmissionProgram         @relation(fields: [program_id], references: [program_id])
  session_id       Int
  session          AdmissionAcademicSession @relation(fields: [session_id], references: [session_id])
  amount           Decimal                  @db.Decimal(12, 2)
  due_date         DateTime                 @db.Date
  created_by       String?
  created_at       DateTime                 @default(now())
  updated_at       DateTime                 @updatedAt

  @@unique([program_id, session_id])
  @@index([institute_id])
  @@map("admission_fee_structures")
}

model AdmissionPayment {
  payment_id      Int                  @id @default(autoincrement())
  application_id  Int
  application     AdmissionApplication @relation(fields: [application_id], references: [application_id])
  amount_paid     Decimal              @db.Decimal(12, 2)
  payment_date    DateTime             @db.Date
  payment_mode    AdmissionPaymentMode
  transaction_ref String?
  receipt_number  String               @unique
  idempotency_key String?
  recorded_by     String?
  created_at      DateTime             @default(now())

  @@unique([application_id, idempotency_key])
  @@index([application_id])
  @@map("admission_payments")
}

model AdmissionConfirmation {
  confirmation_id     Int                         @id @default(autoincrement())
  application_id      Int                         @unique
  application         AdmissionApplication        @relation(fields: [application_id], references: [application_id])
  confirmed_date      DateTime
  enrollment_number   String                      @unique
  status              AdmissionConfirmationStatus @default(confirmed)
  confirmed_by        String?
  cancelled_at        DateTime?
  cancelled_by        String?
  cancellation_reason String?
  /// Reference to the core Student record once the school core system has created it.
  student_ref         String?
  student_link_status AdmissionStudentLinkStatus  @default(pending)
  created_at          DateTime                    @default(now())
  updated_at          DateTime                    @updatedAt

  @@index([status, student_link_status])
  @@map("admission_confirmations")
}

/// DB-logged notification outbox — no SMS/email provider exists in this codebase yet,
/// so rows stay `queued` until a delivery worker exists. Never marked `sent` speculatively.
model AdmissionNotification {
  notification_id Int                          @id @default(autoincrement())
  institute_id    String
  entity_type     String
  entity_id       Int
  event_type      String
  channel         AdmissionNotificationChannel @default(email)
  recipient       String?
  message         String?
  status          AdmissionNotificationStatus  @default(queued)
  sent_at         DateTime?
  created_at      DateTime                     @default(now())

  @@index([institute_id, event_type])
  @@index([entity_type, entity_id])
  @@map("admission_notifications")
}

model AdmissionDynamicRole {
  role_id      Int      @id @default(autoincrement())
  institute_id String
  name         String
  description  String?
  permissions  Json     @default("[]")
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  user_roles AdmissionUserDynamicRole[]

  @@unique([institute_id, name])
  @@map("admission_dynamic_roles")
}

model AdmissionUserDynamicRole {
  id            Int                  @id @default(autoincrement())
  institute_id  String
  eddva_user_id String
  user_name     String
  user_email    String?
  username      String
  password_hash String
  is_active     Boolean              @default(true)
  role_id       Int
  assigned_at   DateTime             @default(now())
  role          AdmissionDynamicRole @relation(fields: [role_id], references: [role_id], onDelete: Cascade)

  @@unique([institute_id, eddva_user_id])
  @@unique([institute_id, username])
  @@map("admission_user_dynamic_roles")
}

model AdmissionSsoSession {
  session_id      Int      @id @default(autoincrement())
  institute_id    String
  eddva_user_id   String
  user_name       String
  user_email      String?
  user_role       String
  token_hash      String   @unique // sha256 of the issued token — the token itself is never stored
  expires_at      DateTime
  created_at      DateTime @default(now())

  @@map("admission_sso_sessions")
}

model AdmissionPermission {
  permission_id Int      @id @default(autoincrement())
  key           String   @unique
  resource      String
  action        String
  name          String
  category      String
  description   String?
  is_system     Boolean  @default(true)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@map("admission_permissions_catalog")
}

/// Module-local document-number sequences (application / hall ticket / receipt / enrollment).
/// Deliberately separate from the shared number_sequences table so Admission stays independent.
model AdmissionNumberSequence {
  id             Int    @id @default(autoincrement())
  sequence_type  String
  financial_year String
  prefix         String
  current_number Int    @default(0)

  @@unique([sequence_type, financial_year])
  @@map("admission_number_sequences")
}

// ═══════════════════════════════════════════════════════════════════════════
// HOSTEL MANAGEMENT — self-contained island (own auth/RBAC, own numbering).
// No Student/Employee master exists in this ERP, so residents carry an external
// `student_ref` plus the minimum identity snapshot (same approach as
// TransportPassenger.external_ref_id / LibMember). Staff (wardens, gate
// security) are identified by `eddva_user_id` strings — not FKs.
// Partial unique indexes (one active allotment per resident/bed, live names)
// live only in the migration SQL — Prisma cannot express them.
// ═══════════════════════════════════════════════════════════════════════════

enum HostelGenderType {
  boys
  girls
  mixed
}

enum HostelResidentGender {
  male
  female
  other
}

enum HostelRoomType {
  single
  double
  triple
  dormitory
}

enum HostelRoomStatus {
  available
  full
  under_maintenance
}

enum HostelBedStatus {
  vacant
  occupied
}

enum HostelResidentStatus {
  active
  vacated
  suspended
}

enum HostelAllotmentStatus {
  active
  vacated
  transferred
}

enum HostelTransferStatus {
  pending
  approved
  rejected
  cancelled
}

enum HostelGatePassType {
  day_outing
  weekend_leave
  home_leave
  medical
}

enum HostelGatePassStatus {
  pending
  approved
  rejected
  out
  returned
  overdue
  expired
  cancelled
}

enum HostelAttendanceSession {
  morning
  night
}

enum HostelAttendanceStatus {
  present
  absent
  on_leave
}

enum HostelMealType {
  breakfast
  lunch
  snacks
  dinner
}

enum HostelDayOfWeek {
  monday
  tuesday
  wednesday
  thursday
  friday
  saturday
  sunday
}

enum HostelMealAttendanceStatus {
  opted_in
  opted_out
  consumed
  missed
}

enum HostelComplaintCategory {
  electrical
  plumbing
  furniture
  cleanliness
  internet
  other
}

enum HostelComplaintPriority {
  low
  medium
  high
  urgent
}

enum HostelComplaintStatus {
  open
  in_progress
  resolved
  closed
}

enum HostelBillingCycle {
  monthly
  quarterly
  annual
}

enum HostelInvoicePaymentStatus {
  unpaid
  partially_paid
  paid
}

enum HostelPaymentMode {
  cash
  card
  upi
  bank_transfer
}

enum HostelDisciplineCategory {
  curfew_violation
  misconduct
  property_damage
  other
}

enum HostelDisciplineAction {
  warning
  fine
  parent_notified
  suspension
}

enum HostelNotificationChannel {
  email
  sms
  in_app
}

enum HostelNotificationAudience {
  guardian
  staff
}

enum HostelNotificationStatus {
  queued
  sent
  failed
}

model HostelBlock {
  block_id       Int              @id @default(autoincrement())
  institute_id   String
  name           String
  gender_type    HostelGenderType
  total_floors   Int              @default(1)
  warden_user_id String? // eddva_user_id of an active hostel staff assignment — not an FK
  warden_name    String?
  description    String?
  is_active      Boolean          @default(true)
  created_by     String?
  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt
  deleted_at     DateTime?

  rooms HostelRoom[]

  @@index([institute_id, is_active])
  @@index([institute_id, gender_type])
  @@map("hostel_blocks")
}

model HostelRoom {
  room_id      Int              @id @default(autoincrement())
  institute_id String
  block_id     Int
  block        HostelBlock      @relation(fields: [block_id], references: [block_id], onDelete: Restrict)
  room_number  String
  floor        Int
  room_type    HostelRoomType
  capacity     Int
  status       HostelRoomStatus @default(available)
  description  String?
  created_by   String?
  created_at   DateTime         @default(now())
  updated_at   DateTime         @updatedAt
  deleted_at   DateTime?

  beds           HostelBed[]
  allotments     HostelRoomAllotment[]
  complaints     HostelComplaint[]
  transfers_from HostelTransferRequest[] @relation("HostelTransferCurrentRoom")
  transfers_to   HostelTransferRequest[] @relation("HostelTransferRequestedRoom")

  @@index([block_id, floor])
  @@index([institute_id, status])
  @@index([institute_id, room_type])
  @@map("hostel_rooms")
}

model HostelBed {
  bed_id       Int             @id @default(autoincrement())
  institute_id String
  room_id      Int
  room         HostelRoom      @relation(fields: [room_id], references: [room_id], onDelete: Restrict)
  bed_number   String
  status       HostelBedStatus @default(vacant)
  created_by   String?
  created_at   DateTime        @default(now())
  updated_at   DateTime        @updatedAt
  deleted_at   DateTime?

  allotments HostelRoomAllotment[]

  @@index([room_id, status])
  @@index([institute_id, status])
  @@map("hostel_beds")
}

/// A student living in the hostel. `student_ref` points at the school's student
/// record (no Student master exists in this backend); identity fields are a snapshot.
model HostelResident {
  resident_id    Int                  @id @default(autoincrement())
  institute_id   String
  student_ref    String
  admission_no   String?
  student_name   String
  gender         HostelResidentGender
  grade          String?
  guardian_name  String
  guardian_phone String
  guardian_email String?
  status         HostelResidentStatus @default(active)
  admitted_on    DateTime             @db.Date
  vacated_on     DateTime?            @db.Date
  status_reason  String?
  created_by     String?
  created_at     DateTime             @default(now())
  updated_at     DateTime             @updatedAt

  allotments         HostelRoomAllotment[]
  transfer_requests  HostelTransferRequest[]
  gate_passes        HostelGatePass[]
  attendance         HostelAttendance[]
  visitor_logs       HostelVisitorLog[]
  meal_attendance    HostelMessAttendance[]
  complaints         HostelComplaint[]
  invoices           HostelFeeInvoice[]
  payments           HostelFeePayment[]
  discipline_records HostelDisciplineRecord[]

  @@unique([institute_id, student_ref])
  @@index([institute_id, status])
  @@index([institute_id, student_name])
  @@index([institute_id, admission_no])
  @@map("hostel_residents")
}

/// One row per stay. Never overwritten: vacating/transferring closes the row and
/// (for transfers) a new row is created, so previous occupancy is always recoverable.
model HostelRoomAllotment {
  allotment_id   Int                   @id @default(autoincrement())
  institute_id   String
  resident_id    Int
  resident       HostelResident        @relation(fields: [resident_id], references: [resident_id], onDelete: Restrict)
  room_id        Int
  room           HostelRoom            @relation(fields: [room_id], references: [room_id], onDelete: Restrict)
  bed_id         Int?
  bed            HostelBed?            @relation(fields: [bed_id], references: [bed_id], onDelete: Restrict)
  academic_year  String
  allotment_date DateTime              @db.Date
  vacate_date    DateTime?             @db.Date
  status         HostelAllotmentStatus @default(active)
  allotted_by    String
  closed_by      String?
  close_reason   String?
  created_at     DateTime              @default(now())
  updated_at     DateTime              @updatedAt

  transfers_closed  HostelTransferRequest[] @relation("HostelTransferCurrentAllotment")
  transfers_created HostelTransferRequest[] @relation("HostelTransferNewAllotment")

  @@index([resident_id, status])
  @@index([room_id, status])
  @@index([bed_id, status])
  @@index([institute_id, academic_year])
  @@map("hostel_room_allotments")
}

model HostelTransferRequest {
  transfer_id          Int                  @id @default(autoincrement())
  institute_id         String
  resident_id          Int
  resident             HostelResident       @relation(fields: [resident_id], references: [resident_id], onDelete: Restrict)
  current_allotment_id Int
  current_allotment    HostelRoomAllotment  @relation("HostelTransferCurrentAllotment", fields: [current_allotment_id], references: [allotment_id], onDelete: Restrict)
  current_room_id      Int
  current_room         HostelRoom           @relation("HostelTransferCurrentRoom", fields: [current_room_id], references: [room_id], onDelete: Restrict)
  requested_room_id    Int
  requested_room       HostelRoom           @relation("HostelTransferRequestedRoom", fields: [requested_room_id], references: [room_id], onDelete: Restrict)
  requested_bed_id     Int?
  reason               String
  status               HostelTransferStatus @default(pending)
  requested_by         String
  requested_at         DateTime             @default(now())
  decided_by           String?
  decided_at           DateTime?
  decision_remarks     String?
  new_allotment_id     Int?
  new_allotment        HostelRoomAllotment? @relation("HostelTransferNewAllotment", fields: [new_allotment_id], references: [allotment_id], onDelete: Restrict)
  updated_at           DateTime             @updatedAt

  @@index([resident_id, status])
  @@index([institute_id, status, requested_at])
  @@map("hostel_transfer_requests")
}

model HostelGatePass {
  gate_pass_id        Int                  @id @default(autoincrement())
  institute_id        String
  pass_no             String
  resident_id         Int
  resident            HostelResident       @relation(fields: [resident_id], references: [resident_id], onDelete: Restrict)
  pass_type           HostelGatePassType
  reason              String
  destination         String
  requested_out_at    DateTime
  expected_return_at  DateTime
  actual_out_at       DateTime?
  actual_return_at    DateTime?
  status              HostelGatePassStatus @default(pending)
  requested_by        String
  approved_by         String?
  rejected_by         String?
  decided_at          DateTime?
  decision_remarks    String?
  scanned_out_by      String?
  scanned_in_by       String?
  overdue_at          DateTime?
  overdue_notified_at DateTime?
  created_at          DateTime             @default(now())
  updated_at          DateTime             @updatedAt

  discipline_records HostelDisciplineRecord[]

  @@unique([institute_id, pass_no])
  @@index([resident_id, status])
  @@index([status, expected_return_at])
  @@index([actual_return_at])
  @@index([institute_id, status, requested_out_at])
  @@map("hostel_gate_passes")
}

model HostelAttendance {
  attendance_id           Int                     @id @default(autoincrement())
  institute_id            String
  resident_id             Int
  resident                HostelResident          @relation(fields: [resident_id], references: [resident_id], onDelete: Restrict)
  attendance_date         DateTime                @db.Date
  session                 HostelAttendanceSession
  status                  HostelAttendanceStatus
  remarks                 String?
  marked_by               String
  marked_at               DateTime                @default(now())
  updated_by              String?
  updated_at              DateTime                @updatedAt
  unaccounted_notified_at DateTime?

  @@unique([resident_id, attendance_date, session])
  @@index([institute_id, attendance_date, status])
  @@index([institute_id, attendance_date, session])
  @@map("hostel_attendance")
}

model HostelVisitorLog {
  visitor_log_id     Int            @id @default(autoincrement())
  institute_id       String
  resident_id        Int
  resident           HostelResident @relation(fields: [resident_id], references: [resident_id], onDelete: Restrict)
  visitor_name       String
  relation           String
  purpose            String?
  id_proof_type      String?
  id_proof_masked    String? // last-4 view shown to everyone
  id_proof_encrypted String? // AES-256-GCM; only decrypted for holders of visitors:view_id
  in_time            DateTime       @default(now())
  out_time           DateTime?
  recorded_by        String
  checked_out_by     String?
  created_at         DateTime       @default(now())
  updated_at         DateTime       @updatedAt

  @@index([resident_id, in_time])
  @@index([institute_id, in_time])
  @@index([institute_id, out_time])
  @@map("hostel_visitor_logs")
}

model HostelMessMenu {
  menu_id        Int             @id @default(autoincrement())
  institute_id   String
  day_of_week    HostelDayOfWeek
  meal_type      HostelMealType
  items          String[]
  effective_from DateTime        @db.Date
  is_active      Boolean         @default(true)
  created_by     String?
  created_at     DateTime        @default(now())
  updated_at     DateTime        @updatedAt

  @@unique([institute_id, day_of_week, meal_type, effective_from])
  @@index([institute_id, is_active, effective_from])
  @@map("hostel_mess_menus")
}

model HostelMessAttendance {
  mess_attendance_id Int                        @id @default(autoincrement())
  institute_id       String
  resident_id        Int
  resident           HostelResident             @relation(fields: [resident_id], references: [resident_id], onDelete: Restrict)
  meal_date          DateTime                   @db.Date
  meal_type          HostelMealType
  status             HostelMealAttendanceStatus
  marked_by          String
  marked_at          DateTime                   @default(now())
  updated_by         String?
  updated_at         DateTime                   @updatedAt

  @@unique([resident_id, meal_date, meal_type])
  @@index([institute_id, meal_date, meal_type, status])
  @@map("hostel_mess_attendance")
}

model HostelComplaint {
  complaint_id     Int                     @id @default(autoincrement())
  institute_id     String
  resident_id      Int?
  resident         HostelResident?         @relation(fields: [resident_id], references: [resident_id], onDelete: Restrict)
  room_id          Int?
  room             HostelRoom?             @relation(fields: [room_id], references: [room_id], onDelete: Restrict)
  category         HostelComplaintCategory
  description      String
  priority         HostelComplaintPriority @default(medium)
  status           HostelComplaintStatus   @default(open)
  assigned_to      String? // eddva_user_id of active hostel staff — not an FK
  assigned_to_name String?
  resolution_notes String?
  created_by       String?
  created_at       DateTime                @default(now())
  resolved_at      DateTime?
  closed_at        DateTime?
  updated_at       DateTime                @updatedAt

  updates HostelComplaintUpdate[]

  @@index([resident_id, status])
  @@index([institute_id, status, priority])
  @@index([assigned_to, status])
  @@index([room_id])
  @@map("hostel_complaints")
}

model HostelComplaintUpdate {
  update_id     Int             @id @default(autoincrement())
  complaint_id  Int
  complaint     HostelComplaint @relation(fields: [complaint_id], references: [complaint_id], onDelete: Cascade)
  notes         String
  status_change String?
  updated_by    String?
  updated_at    DateTime        @default(now())

  @@index([complaint_id])
  @@map("hostel_complaint_updates")
}

model HostelFeePlan {
  fee_plan_id   Int                @id @default(autoincrement())
  institute_id  String
  name          String
  room_type     HostelRoomType
  includes_mess Boolean            @default(false)
  amount        Decimal            @db.Decimal(12, 2)
  billing_cycle HostelBillingCycle
  description   String?
  is_active     Boolean            @default(true)
  created_by    String?
  created_at    DateTime           @default(now())
  updated_at    DateTime           @updatedAt
  deleted_at    DateTime?

  invoices HostelFeeInvoice[]

  @@index([institute_id, room_type, is_active])
  @@map("hostel_fee_plans")
}

/// The plan's terms (name, room type, cycle, amount) are copied onto the invoice,
/// so a later plan change never alters an invoice that has already been issued.
model HostelFeeInvoice {
  invoice_id          Int                        @id @default(autoincrement())
  institute_id        String
  invoice_no          String
  resident_id         Int
  resident            HostelResident             @relation(fields: [resident_id], references: [resident_id], onDelete: Restrict)
  fee_plan_id         Int
  fee_plan            HostelFeePlan              @relation(fields: [fee_plan_id], references: [fee_plan_id], onDelete: Restrict)
  plan_name           String
  room_type           HostelRoomType
  includes_mess       Boolean
  billing_cycle       HostelBillingCycle
  billing_period      String
  period_start        DateTime                   @db.Date
  period_end          DateTime                   @db.Date
  amount_due          Decimal                    @db.Decimal(12, 2)
  amount_paid         Decimal                    @default(0) @db.Decimal(12, 2)
  payment_status      HostelInvoicePaymentStatus @default(unpaid)
  issued_on           DateTime                   @db.Date
  due_date            DateTime                   @db.Date
  remarks             String?
  overdue_notified_at DateTime?
  cancelled_at        DateTime?
  cancelled_by        String?
  cancel_reason       String?
  created_by          String?
  created_at          DateTime                   @default(now())
  updated_at          DateTime                   @updatedAt

  payments HostelFeePayment[]

  @@unique([institute_id, invoice_no])
  @@index([resident_id, period_start])
  @@index([institute_id, payment_status])
  @@index([institute_id, due_date])
  @@map("hostel_fee_invoices")
}

model HostelFeePayment {
  payment_id      Int               @id @default(autoincrement())
  institute_id    String
  receipt_no      String
  invoice_id      Int
  invoice         HostelFeeInvoice  @relation(fields: [invoice_id], references: [invoice_id], onDelete: Restrict)
  resident_id     Int
  resident        HostelResident    @relation(fields: [resident_id], references: [resident_id], onDelete: Restrict)
  amount_paid     Decimal           @db.Decimal(12, 2)
  payment_date    DateTime          @db.Date
  payment_mode    HostelPaymentMode
  transaction_ref String?
  received_by     String
  remarks         String?
  created_at      DateTime          @default(now())

  @@unique([institute_id, receipt_no])
  @@index([invoice_id])
  @@index([institute_id, payment_date])
  @@index([resident_id])
  @@map("hostel_fee_payments")
}

model HostelDisciplineRecord {
  record_id     Int                      @id @default(autoincrement())
  institute_id  String
  resident_id   Int
  resident      HostelResident           @relation(fields: [resident_id], references: [resident_id], onDelete: Restrict)
  incident_date DateTime                 @db.Date
  category      HostelDisciplineCategory
  description   String
  action_taken  HostelDisciplineAction
  fine_amount   Decimal?                 @db.Decimal(12, 2)
  gate_pass_id  Int?
  gate_pass     HostelGatePass?          @relation(fields: [gate_pass_id], references: [gate_pass_id], onDelete: Restrict)
  recorded_by   String
  created_at    DateTime                 @default(now())
  updated_at    DateTime                 @updatedAt

  @@index([resident_id, incident_date])
  @@index([institute_id, category, incident_date])
  @@index([gate_pass_id])
  @@map("hostel_discipline_records")
}

/// DB-logged outbox — no SMS/email provider exists in this ERP, so rows stay `queued`.
model HostelNotification {
  notification_id Int                        @id @default(autoincrement())
  institute_id    String
  entity_type     String
  entity_id       Int
  event_type      String
  audience        HostelNotificationAudience
  channel         HostelNotificationChannel  @default(sms)
  recipient       String?
  message         String?
  status          HostelNotificationStatus   @default(queued)
  sent_at         DateTime?
  created_at      DateTime                   @default(now())

  @@index([institute_id, event_type])
  @@index([entity_type, entity_id])
  @@map("hostel_notifications")
}

// ─── Hostel RBAC — parallel dynamic-role system, same architecture as Admission/Front Office/Canteen ───

model HostelDynamicRole {
  role_id      Int      @id @default(autoincrement())
  institute_id String
  name         String
  description  String?
  permissions  Json     @default("[]")
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  user_roles HostelUserDynamicRole[]

  @@unique([institute_id, name])
  @@map("hostel_dynamic_roles")
}

model HostelUserDynamicRole {
  id            Int               @id @default(autoincrement())
  institute_id  String
  eddva_user_id String
  user_name     String
  user_email    String?
  username      String
  password_hash String
  is_active     Boolean           @default(true)
  role_id       Int
  assigned_at   DateTime          @default(now())
  role          HostelDynamicRole @relation(fields: [role_id], references: [role_id], onDelete: Cascade)

  @@unique([institute_id, eddva_user_id])
  @@unique([institute_id, username])
  @@map("hostel_user_dynamic_roles")
}

model HostelSsoSession {
  session_id    Int      @id @default(autoincrement())
  institute_id  String
  eddva_user_id String
  user_name     String
  user_email    String?
  user_role     String
  token_hash    String   @unique // sha256 of the issued token — the token itself is never stored
  expires_at    DateTime
  created_at    DateTime @default(now())

  @@map("hostel_sso_sessions")
}

model HostelPermission {
  permission_id Int      @id @default(autoincrement())
  key           String   @unique
  resource      String
  action        String
  name          String
  category      String
  description   String?
  is_system     Boolean  @default(true)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@map("hostel_permissions_catalog")
}

/// Module-local document-number sequences (gate pass / invoice / receipt).
model HostelNumberSequence {
  id             Int    @id @default(autoincrement())
  sequence_type  String
  financial_year String
  prefix         String
  current_number Int    @default(0)

  @@unique([sequence_type, financial_year])
  @@map("hostel_number_sequences")
}

// ═══════════════════════════════════════════════════════════════════════════
// ALUMNI MANAGEMENT — self-contained module (own auth island, own tables).
// The alumni profile is the anchor entity; events, jobs, mentorship, donations
// and communication all reference it. There is no Student master in this
// backend, so `student_ref` is the external reference to the school record.
// ═══════════════════════════════════════════════════════════════════════════

enum AlumniVerificationStatus {
  pending
  verified
  rejected
}

enum AlumniVisibility {
  public
  alumni_only
  private
}

enum AlumniSource {
  staff_created
  self_registered
}

enum AlumniGroupType {
  batch
  program
  location
  interest
}

enum AlumniEventType {
  reunion
  webinar
  networking
  fundraiser
}

enum AlumniEventMode {
  online
  offline
  hybrid
}

enum AlumniEventStatus {
  upcoming
  ongoing
  completed
  cancelled
}

enum AlumniAttendanceStatus {
  registered
  attended
  no_show
  cancelled
}

enum AlumniEventPaymentStatus {
  not_applicable
  pending
  paid
}

enum AlumniEventPaymentMode {
  card
  upi
  bank_transfer
}

enum AlumniJobType {
  full_time
  part_time
  internship
  contract
}

enum AlumniJobStatus {
  open
  closed
  expired
}

enum AlumniApplicationStatus {
  applied
  shortlisted
  rejected
  hired
  withdrawn
}

enum AlumniProgramStatus {
  open_for_signup
  active
  completed
}

enum AlumniMentorStatus {
  available
  fully_booked
  inactive
}

enum AlumniMatchStatus {
  active
  completed
  discontinued
}

enum AlumniCampaignStatus {
  active
  completed
  closed
}

enum AlumniDonationStatus {
  pending
  received
  failed
  cancelled
  reversed
}

enum AlumniDonationPaymentMode {
  card
  upi
  bank_transfer
  cheque
}

enum AlumniNewsletterStatus {
  draft
  sent
}

enum AlumniCommChannel {
  email
  sms
}

enum AlumniCommStatus {
  queued
  sent
  opened
  clicked
  failed
}

enum AlumniNotificationChannel {
  email
  sms
  in_app
}

enum AlumniNotificationAudience {
  alumni
  staff
}

enum AlumniNotificationStatus {
  queued
  sent
  failed
}

/// The alumni directory — one row per alumnus/alumna per institute.
model AlumniProfile {
  alumni_id                 Int                      @id @default(autoincrement())
  institute_id              String
  /// External reference to the historical student record (no Student master exists here).
  student_ref               String?
  admission_no              String?
  full_name                 String
  batch_year                Int
  graduation_year           Int?
  program                   String?
  /// Always stored lower-case; unique per institute.
  email                     String
  phone                     String?
  current_company           String?
  current_designation       String?
  industry                  String?
  city                      String?
  country                   String?
  linkedin_url              String?
  photo_path                String?
  photo_mime                String?
  verification_status       AlumniVerificationStatus @default(pending)
  /// Evidence/notes the alumnus submitted with their verification request.
  verification_note         String?
  verification_requested_at DateTime?
  verified_at               DateTime?
  verified_by               String?
  rejection_reason          String?
  visibility                AlumniVisibility         @default(alumni_only)
  /// When false, other alumni never see this person's email/phone.
  contact_visible           Boolean                  @default(false)
  email_opt_in              Boolean                  @default(true)
  sms_opt_in                Boolean                  @default(true)
  source                    AlumniSource
  is_active                 Boolean                  @default(true)
  registered_at             DateTime                 @default(now())
  created_by                String?
  created_at                DateTime                 @default(now())
  updated_at                DateTime                 @updatedAt

  employments         AlumniEmployment[]
  group_memberships   AlumniGroupMember[]
  event_registrations AlumniEventRegistration[]
  posted_jobs         AlumniJob[]
  job_applications    AlumniJobApplication[]
  mentor_profile      AlumniMentorProfile?
  mentee_matches      AlumniMentorshipMatch[]
  donations           AlumniDonation[]
  communication_logs  AlumniCommunicationLog[]
  account             AlumniUserDynamicRole?

  @@unique([institute_id, email])
  @@unique([institute_id, student_ref])
  @@index([institute_id, batch_year])
  @@index([institute_id, program])
  @@index([institute_id, current_company])
  @@index([institute_id, industry])
  @@index([institute_id, city])
  @@index([institute_id, country])
  @@index([institute_id, verification_status])
  @@index([institute_id, full_name])
  @@map("alumni_profiles")
}

model AlumniEmployment {
  employment_id Int           @id @default(autoincrement())
  institute_id  String
  alumni_id     Int
  company       String
  designation   String
  industry      String?
  location      String?
  start_date    DateTime      @db.Date
  end_date      DateTime?     @db.Date
  is_current    Boolean       @default(false)
  /// Soft delete: a removed entry stays for audit but leaves the timeline.
  is_active     Boolean       @default(true)
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt
  alumni        AlumniProfile @relation(fields: [alumni_id], references: [alumni_id], onDelete: Restrict)

  @@index([alumni_id, is_active])
  @@index([institute_id, company])
  @@map("alumni_employments")
}

model AlumniGroup {
  group_id     Int                 @id @default(autoincrement())
  institute_id String
  name         String
  group_type   AlumniGroupType
  description  String?
  is_active    Boolean             @default(true)
  created_by   String?
  created_at   DateTime            @default(now())
  updated_at   DateTime            @updatedAt
  members      AlumniGroupMember[]

  @@unique([institute_id, group_type, name])
  @@index([institute_id, group_type])
  @@map("alumni_groups")
}

model AlumniGroupMember {
  member_id    Int           @id @default(autoincrement())
  institute_id String
  group_id     Int
  alumni_id    Int
  joined_at    DateTime      @default(now())
  added_by     String?
  group        AlumniGroup   @relation(fields: [group_id], references: [group_id], onDelete: Cascade)
  alumni       AlumniProfile @relation(fields: [alumni_id], references: [alumni_id], onDelete: Restrict)

  @@unique([group_id, alumni_id])
  @@index([alumni_id])
  @@map("alumni_group_members")
}

model AlumniEvent {
  event_id              Int                       @id @default(autoincrement())
  institute_id          String
  title                 String
  description           String?
  event_type            AlumniEventType
  mode                  AlumniEventMode
  venue                 String?
  online_link           String?
  event_date            DateTime
  ends_at               DateTime?
  registration_deadline DateTime?
  max_capacity          Int?
  is_paid               Boolean                   @default(false)
  ticket_price          Decimal?                  @db.Decimal(10, 2)
  status                AlumniEventStatus         @default(upcoming)
  banner_path           String?
  banner_mime           String?
  cancel_reason         String?
  cancelled_at          DateTime?
  created_by            String
  created_at            DateTime                  @default(now())
  updated_at            DateTime                  @updatedAt
  registrations         AlumniEventRegistration[]

  @@index([institute_id, status, event_date])
  @@index([institute_id, event_date])
  @@index([registration_deadline])
  @@map("alumni_events")
}

model AlumniEventRegistration {
  registration_id      Int                      @id @default(autoincrement())
  institute_id         String
  event_id             Int
  alumni_id            Int
  registered_at        DateTime                 @default(now())
  attendance_status    AlumniAttendanceStatus   @default(registered)
  payment_status       AlumniEventPaymentStatus @default(not_applicable)
  /// Ticket price captured at registration time.
  amount_due           Decimal?                 @db.Decimal(10, 2)
  cancelled_at         DateTime?
  attendance_marked_at DateTime?
  attendance_marked_by String?
  reminder_queued_at   DateTime?
  registered_by        String
  created_at           DateTime                 @default(now())
  updated_at           DateTime                 @updatedAt
  event                AlumniEvent              @relation(fields: [event_id], references: [event_id], onDelete: Restrict)
  alumni               AlumniProfile            @relation(fields: [alumni_id], references: [alumni_id], onDelete: Restrict)
  payment              AlumniEventPayment?

  @@unique([event_id, alumni_id])
  @@index([event_id, attendance_status])
  @@index([alumni_id])
  @@map("alumni_event_registrations")
}

model AlumniEventPayment {
  payment_id      Int                     @id @default(autoincrement())
  institute_id    String
  registration_id Int                     @unique
  amount          Decimal                 @db.Decimal(10, 2)
  payment_mode    AlumniEventPaymentMode
  transaction_ref String
  paid_at         DateTime
  recorded_by     String
  created_at      DateTime                @default(now())
  registration    AlumniEventRegistration @relation(fields: [registration_id], references: [registration_id], onDelete: Restrict)

  @@unique([institute_id, transaction_ref])
  @@map("alumni_event_payments")
}

model AlumniJob {
  job_id              Int                    @id @default(autoincrement())
  institute_id        String
  /// Null when staff post on behalf of a partner company.
  posted_by_alumni_id Int?
  posted_by_user_id   String?
  title               String
  company             String
  description         String
  location            String?
  job_type            AlumniJobType
  industry            String?
  posted_date         DateTime               @default(now())
  expiry_date         DateTime?
  status              AlumniJobStatus        @default(open)
  closed_at           DateTime?
  created_at          DateTime               @default(now())
  updated_at          DateTime               @updatedAt
  posted_by           AlumniProfile?         @relation(fields: [posted_by_alumni_id], references: [alumni_id], onDelete: Restrict)
  applications        AlumniJobApplication[]

  @@index([institute_id, status, expiry_date])
  @@index([posted_by_alumni_id])
  @@index([institute_id, job_type])
  @@index([institute_id, company])
  @@map("alumni_jobs")
}

model AlumniJobApplication {
  application_id      Int                     @id @default(autoincrement())
  institute_id        String
  job_id              Int
  applicant_alumni_id Int
  applied_at          DateTime                @default(now())
  status              AlumniApplicationStatus @default(applied)
  resume_url          String?
  resume_path         String?
  resume_mime         String?
  cover_note          String?
  status_note         String?
  status_updated_at   DateTime?
  status_updated_by   String?
  created_at          DateTime                @default(now())
  updated_at          DateTime                @updatedAt
  job                 AlumniJob               @relation(fields: [job_id], references: [job_id], onDelete: Restrict)
  applicant           AlumniProfile           @relation(fields: [applicant_alumni_id], references: [alumni_id], onDelete: Restrict)

  @@unique([job_id, applicant_alumni_id])
  @@index([job_id, status])
  @@index([applicant_alumni_id])
  @@index([institute_id, status])
  @@map("alumni_job_applications")
}

model AlumniMentorshipProgram {
  program_id   Int                     @id @default(autoincrement())
  institute_id String
  name         String
  description  String?
  start_date   DateTime                @db.Date
  end_date     DateTime                @db.Date
  status       AlumniProgramStatus     @default(open_for_signup)
  created_by   String?
  created_at   DateTime                @default(now())
  updated_at   DateTime                @updatedAt
  matches      AlumniMentorshipMatch[]

  @@unique([institute_id, name])
  @@index([institute_id, status])
  @@map("alumni_mentorship_programs")
}

model AlumniMentorProfile {
  mentor_id         Int                     @id @default(autoincrement())
  institute_id      String
  alumni_id         Int                     @unique
  /// Normalised (trimmed, lower-case, de-duplicated) tags; GIN-indexed in SQL.
  expertise_areas   String[]
  max_mentees       Int                     @default(3)
  status            AlumniMentorStatus      @default(available)
  bio               String?
  availability_note String?
  created_at        DateTime                @default(now())
  updated_at        DateTime                @updatedAt
  alumni            AlumniProfile           @relation(fields: [alumni_id], references: [alumni_id], onDelete: Restrict)
  matches           AlumniMentorshipMatch[]

  @@index([institute_id, status])
  @@index([expertise_areas(ops: ArrayOps)], type: Gin, map: "alumni_mentor_profiles_expertise_gin_idx")
  @@map("alumni_mentor_profiles")
}

model AlumniMentorshipMatch {
  match_id           Int                     @id @default(autoincrement())
  institute_id       String
  program_id         Int
  mentor_id          Int
  /// Exactly one of mentee_alumni_id / mentee_student_ref is set (CHECK in SQL).
  mentee_alumni_id   Int?
  mentee_student_ref String?
  mentee_name        String?
  matched_date       DateTime                @db.Date
  status             AlumniMatchStatus       @default(active)
  ended_at           DateTime?
  end_reason         String?
  created_by         String?
  created_at         DateTime                @default(now())
  updated_at         DateTime                @updatedAt
  program            AlumniMentorshipProgram @relation(fields: [program_id], references: [program_id], onDelete: Restrict)
  mentor             AlumniMentorProfile     @relation(fields: [mentor_id], references: [mentor_id], onDelete: Restrict)
  mentee_alumni      AlumniProfile?          @relation(fields: [mentee_alumni_id], references: [alumni_id], onDelete: Restrict)

  @@index([mentor_id, status])
  @@index([institute_id, program_id, status])
  @@index([mentee_alumni_id])
  @@map("alumni_mentorship_matches")
}

model AlumniCampaign {
  campaign_id   Int                  @id @default(autoincrement())
  institute_id  String
  title         String
  description   String?
  goal_amount   Decimal              @db.Decimal(14, 2)
  /// CACHE of SUM(received donations) — the donation ledger is the source of truth.
  raised_amount Decimal              @default(0) @db.Decimal(14, 2)
  start_date    DateTime             @db.Date
  end_date      DateTime             @db.Date
  status        AlumniCampaignStatus @default(active)
  closed_at     DateTime?
  created_by    String?
  created_at    DateTime             @default(now())
  updated_at    DateTime             @updatedAt
  donations     AlumniDonation[]

  @@index([institute_id, status])
  @@index([institute_id, start_date, end_date])
  @@map("alumni_campaigns")
}

model AlumniDonation {
  donation_id       Int                       @id @default(autoincrement())
  institute_id      String
  alumni_id         Int
  /// Null for a general / unrestricted donation.
  campaign_id       Int?
  amount            Decimal                   @db.Decimal(12, 2)
  donation_date     DateTime                  @default(now())
  payment_mode      AlumniDonationPaymentMode
  transaction_ref   String?
  is_anonymous      Boolean                   @default(false)
  status            AlumniDonationStatus      @default(pending)
  receipt_number    String?
  receipt_issued_at DateTime?
  received_at       DateTime?
  received_by       String?
  notes             String?
  status_reason     String?
  reversed_at       DateTime?
  reversed_by       String?
  recorded_by       String
  created_at        DateTime                  @default(now())
  updated_at        DateTime                  @updatedAt
  alumni            AlumniProfile             @relation(fields: [alumni_id], references: [alumni_id], onDelete: Restrict)
  campaign          AlumniCampaign?           @relation(fields: [campaign_id], references: [campaign_id], onDelete: Restrict)

  @@unique([institute_id, receipt_number])
  @@index([institute_id, campaign_id, status])
  @@index([alumni_id, status])
  @@index([institute_id, donation_date])
  @@map("alumni_donations")
}

model AlumniNewsletter {
  newsletter_id   Int                      @id @default(autoincrement())
  institute_id    String
  title           String
  content         String
  /// Structured, validated filter evaluated against current alumni data at send time.
  target_segment  Json
  status          AlumniNewsletterStatus   @default(draft)
  sent_at         DateTime?
  sent_by         String?
  recipient_count Int?
  created_by      String
  created_at      DateTime                 @default(now())
  updated_at      DateTime                 @updatedAt
  logs            AlumniCommunicationLog[]

  @@index([institute_id, status])
  @@map("alumni_newsletters")
}

model AlumniCommunicationLog {
  log_id         Int               @id @default(autoincrement())
  institute_id   String
  newsletter_id  Int
  alumni_id      Int
  channel        AlumniCommChannel
  /// Address the message was queued for (email / phone at send time).
  recipient      String
  status         AlumniCommStatus  @default(queued)
  sent_at        DateTime?
  opened_at      DateTime?
  clicked_at     DateTime?
  failure_reason String?
  created_at     DateTime          @default(now())
  updated_at     DateTime          @updatedAt
  newsletter     AlumniNewsletter  @relation(fields: [newsletter_id], references: [newsletter_id], onDelete: Cascade)
  alumni         AlumniProfile     @relation(fields: [alumni_id], references: [alumni_id], onDelete: Restrict)

  @@unique([newsletter_id, alumni_id, channel])
  @@index([newsletter_id, status])
  @@index([alumni_id])
  @@map("alumni_communication_logs")
}

model AlumniNotification {
  notification_id Int                        @id @default(autoincrement())
  institute_id    String
  /// Set for alumni-audience rows: lets the alumnus read their own in-app notices.
  alumni_id       Int?
  entity_type     String
  entity_id       Int
  event_type      String
  audience        AlumniNotificationAudience
  channel         AlumniNotificationChannel  @default(in_app)
  recipient       String?
  message         String?
  status          AlumniNotificationStatus   @default(queued)
  sent_at         DateTime?
  created_at      DateTime                   @default(now())

  @@index([institute_id, event_type])
  @@index([entity_type, entity_id])
  @@index([alumni_id, created_at])
  @@map("alumni_notifications")
}

// ─── Alumni RBAC — parallel dynamic-role system, same architecture as Admission/Hostel/Front Office ───

model AlumniDynamicRole {
  role_id      Int      @id @default(autoincrement())
  institute_id String
  name         String
  description  String?
  permissions  Json     @default("[]")
  /// The self-service "Alumni" role auto-created on first registration; cannot be deleted.
  is_system    Boolean  @default(false)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  user_roles AlumniUserDynamicRole[]

  @@unique([institute_id, name])
  @@map("alumni_dynamic_roles")
}

model AlumniUserDynamicRole {
  id            Int               @id @default(autoincrement())
  institute_id  String
  eddva_user_id String
  user_name     String
  user_email    String?
  username      String
  password_hash String
  is_active     Boolean           @default(true)
  role_id       Int
  /// Set for alumni-portal accounts (exactly one account per alumni record); null for staff.
  alumni_id     Int?              @unique
  assigned_at   DateTime          @default(now())
  role          AlumniDynamicRole @relation(fields: [role_id], references: [role_id], onDelete: Cascade)
  alumni        AlumniProfile?    @relation(fields: [alumni_id], references: [alumni_id], onDelete: Restrict)

  @@unique([institute_id, eddva_user_id])
  @@unique([institute_id, username])
  @@map("alumni_user_dynamic_roles")
}

model AlumniSsoSession {
  session_id    Int      @id @default(autoincrement())
  institute_id  String
  eddva_user_id String
  user_name     String
  user_email    String?
  user_role     String
  token_hash    String   @unique
  expires_at    DateTime
  created_at    DateTime @default(now())

  @@map("alumni_sso_sessions")
}

model AlumniPermission {
  permission_id Int      @id @default(autoincrement())
  key           String   @unique
  resource      String
  action        String
  name          String
  category      String
  description   String?
  is_system     Boolean  @default(true)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@map("alumni_permissions_catalog")
}

/// Module-local document-number sequences (donation receipts).
model AlumniNumberSequence {
  id             Int    @id @default(autoincrement())
  sequence_type  String
  financial_year String
  prefix         String
  current_number Int    @default(0)

  @@unique([sequence_type, financial_year])
  @@map("alumni_number_sequences")
}
