datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Status {
  ACTIVE
  INACTIVE
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum RoleStatus {
  ACTIVE
  INACTIVE
}

enum VendorStatus {
  ACTIVE
  INACTIVE
  BLACKLISTED
}

enum DocumentType {
  PO
  GRN
  PURCHASE_INVOICE
  SALES_ORDER
  SALES_INVOICE
  PAYMENT
  RECEIPT
  VISITOR_BADGE
}

enum PoStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PARTIALLY_RECEIVED
  CLOSED
  CANCELLED
}

enum PoApprovalAction {
  SUBMIT
  APPROVE
  REJECT
}

enum GrnStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum SoStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_INVOICED
  INVOICED
  CANCELLED
}

enum PaymentMode {
  CASH
  BANK_TRANSFER
  UPI
  CHEQUE
  CARD
  OTHER
}

model User {
  id                      String                 @id @default(uuid())
  instituteId             String?
  name                    String
  email                   String                 @unique
  passwordHash            String
  roleId                  String
  role                    Role                   @relation(fields: [roleId], references: [id])
  status                  UserStatus             @default(ACTIVE)
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  createdPurchaseOrders   PurchaseOrder[]        @relation("CreatedPOs")
  approvedPurchaseOrders  PurchaseOrder[]        @relation("ApprovedPOs")
  poApprovals             PoApproval[]
  createdGrns             GoodsReceiptNote[]     @relation("CreatedGRNs")
  createdPurchaseInvoices PurchaseInvoice[]      @relation("CreatedPIs")
  postedPurchaseInvoices  PurchaseInvoice[]      @relation("PostedPIs")
  createdPurchasePayments PurchasePayment[]
  createdSalesOrders      SalesOrder[]           @relation("CreatedSOs")
  createdSalesInvoices    SalesInvoice[]         @relation("CreatedSIs")
  postedSalesInvoices     SalesInvoice[]         @relation("PostedSIs")
  createdSalesReceipts    SalesReceipt[]
  auditLogs               AuditLog[]
  inventoryTransactions   InventoryTransaction[]
  canteenUserRoles        CanteenUserRole[]
  canteenShifts           CanteenPosShift[]
  createdCanteenOrders    CanteenOrder[]         @relation("CreatedCanteenOrders")
  receivedCanteenPayments CanteenPayment[]       @relation("ReceivedCanteenPayments")
  approvedCanteenTopups   CanteenWalletTopup[]   @relation("ApprovedCanteenTopups")

  @@map("users")
}

model Role {
  id              String           @id @default(uuid())
  instituteId     String?
  roleName        String
  description     String?
  status          RoleStatus       @default(ACTIVE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @default(now()) @updatedAt
  users           User[]
  rolePermissions RolePermission[]
  approvalRules   ApprovalRule[]

  @@unique([roleName, instituteId])
  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid())
  instituteId     String?
  isSystem        Boolean          @default(false)
  permissionKey   String           @unique
  description     String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @default(now()) @updatedAt
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model ItemCategory {
  id           String  @id @default(uuid())
  instituteId  String?
  categoryName String  @unique
  status       Status  @default(ACTIVE)
  items        Item[]

  @@map("item_categories")
}

model Uom {
  id     String @id @default(uuid())
  name   String
  code   String @unique
  status Status @default(ACTIVE)
  items  Item[]

  @@map("uom")
}

model Item {
  id                    String                 @id @default(uuid())
  instituteId           String?
  itemCode              String                 @unique
  itemName              String
  categoryId            String
  category              ItemCategory           @relation(fields: [categoryId], references: [id])
  uomId                 String
  uom                   Uom                    @relation(fields: [uomId], references: [id])
  hsnSacCode            String
  purchasePrice         Decimal                @db.Decimal(12, 2)
  salesPrice            Decimal                @db.Decimal(12, 2)
  taxCodeId             String
  taxCode               TaxCode                @relation(fields: [taxCodeId], references: [id])
  quantity              Decimal                @default(0) @db.Decimal(12, 3)
  status                Status                 @default(ACTIVE)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  poItems               PurchaseOrderItem[]
  grnItems              GrnItem[]
  piItems               PurchaseInvoiceItem[]
  soItems               SalesOrderItem[]
  siItems               SalesInvoiceItem[]
  inventoryTransactions InventoryTransaction[]

  @@map("items")
}

model TaxCode {
  id            String                @id @default(uuid())
  name          String
  cgstPct       Decimal               @db.Decimal(5, 2)
  sgstPct       Decimal               @db.Decimal(5, 2)
  igstPct       Decimal               @db.Decimal(5, 2)
  effectiveFrom DateTime
  status        Status                @default(ACTIVE)
  createdAt     DateTime              @default(now())
  items         Item[]
  poItems       PurchaseOrderItem[]
  piItems       PurchaseInvoiceItem[]
  soItems       SalesOrderItem[]
  siItems       SalesInvoiceItem[]

  @@map("tax_codes")
}

model PaymentTerm {
  id        String     @id @default(uuid())
  termName  String     @unique
  days      Int
  status    Status     @default(ACTIVE)
  vendors   Vendor[]
  customers Customer[]

  @@map("payment_terms")
}

model Warehouse {
  id                    String                 @id @default(uuid())
  instituteId           String?
  name                  String
  address               String
  isDefault             Boolean                @default(false)
  status                Status                 @default(ACTIVE)
  purchaseOrders        PurchaseOrder[]
  goodsReceiptNotes     GoodsReceiptNote[]
  inventoryTransactions InventoryTransaction[]

  @@map("warehouses")
}

model Vendor {
  id                String             @id @default(uuid())
  instituteId       String?
  vendorCode        String             @unique
  vendorName        String
  gstin             String?
  taxId             String?
  addressLine1      String
  addressLine2      String?
  city              String
  state             String
  pincode           String
  paymentTermId     String
  paymentTerm       PaymentTerm        @relation(fields: [paymentTermId], references: [id])
  creditLimit       Decimal            @default(0) @db.Decimal(12, 2)
  status            VendorStatus       @default(ACTIVE)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  contacts          VendorContact[]
  bankDetails       VendorBankDetail[]
  purchaseOrders    PurchaseOrder[]
  goodsReceiptNotes GoodsReceiptNote[]
  purchaseInvoices  PurchaseInvoice[]

  @@map("vendors")
}

model VendorContact {
  id          String  @id @default(uuid())
  vendorId    String
  vendor      Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name        String
  designation String?
  phone       String
  email       String

  @@map("vendor_contacts")
}

model VendorBankDetail {
  id        String  @id @default(uuid())
  vendorId  String
  vendor    Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  accountNo String
  ifsc      String
  swift     String?
  bankName  String
  isPrimary Boolean @default(false)

  @@map("vendor_bank_details")
}

model Customer {
  id            String            @id @default(uuid())
  instituteId   String?
  customerCode  String            @unique
  customerName  String
  gstin         String?
  addressLine1  String
  addressLine2  String?
  city          String
  state         String
  pincode       String
  paymentTermId String
  paymentTerm   PaymentTerm       @relation(fields: [paymentTermId], references: [id])
  creditLimit   Decimal           @default(0) @db.Decimal(12, 2)
  status        Status            @default(ACTIVE)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  contacts      CustomerContact[]
  salesOrders   SalesOrder[]
  salesInvoices SalesInvoice[]

  @@map("customers")
}

model CustomerContact {
  id          String   @id @default(uuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name        String
  designation String?
  phone       String
  email       String

  @@map("customer_contacts")
}

model NumberSequence {
  id            String       @id @default(uuid())
  documentType  DocumentType
  financialYear String
  prefix        String
  currentNumber Int          @default(0)

  @@unique([documentType, financialYear])
  @@map("number_sequences")
}

model ApprovalRule {
  id             String       @id @default(uuid())
  documentType   DocumentType @default(PO)
  minAmount      Decimal      @db.Decimal(12, 2)
  maxAmount      Decimal?     @db.Decimal(12, 2)
  requiredRoleId String
  requiredRole   Role         @relation(fields: [requiredRoleId], references: [id])
  approvalLevel  Int
  status         Status       @default(ACTIVE)

  @@map("approval_rules")
}

model PurchaseOrder {
  id                   String              @id @default(uuid())
  instituteId          String?
  poNumber             String              @unique
  vendorId             String
  vendor               Vendor              @relation(fields: [vendorId], references: [id])
  poDate               DateTime
  expectedDeliveryDate DateTime
  warehouseId          String
  warehouse            Warehouse           @relation(fields: [warehouseId], references: [id])
  status               PoStatus            @default(DRAFT)
  subtotal             Decimal             @db.Decimal(12, 2)
  taxAmount            Decimal             @db.Decimal(12, 2)
  discount             Decimal             @default(0) @db.Decimal(12, 2)
  grandTotal           Decimal             @db.Decimal(12, 2)
  createdBy            String
  creator              User                @relation("CreatedPOs", fields: [createdBy], references: [id])
  approvedBy           String?
  approver             User?               @relation("ApprovedPOs", fields: [approvedBy], references: [id])
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  items                PurchaseOrderItem[]
  approvals            PoApproval[]
  goodsReceiptNotes    GoodsReceiptNote[]
  purchaseInvoices     PurchaseInvoice[]

  @@index([vendorId])
  @@index([instituteId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id          String        @id @default(uuid())
  poId        String
  po          PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  itemId      String
  item        Item          @relation(fields: [itemId], references: [id])
  quantity    Decimal       @db.Decimal(12, 2)
  unitPrice   Decimal       @db.Decimal(12, 2)
  taxCodeId   String
  taxCode     TaxCode       @relation(fields: [taxCodeId], references: [id])
  lineTotal   Decimal       @db.Decimal(12, 2)
  receivedQty Decimal       @default(0) @db.Decimal(12, 2)
  grnItems    GrnItem[]

  @@map("purchase_order_items")
}

model PoApproval {
  id            String           @id @default(uuid())
  poId          String
  po            PurchaseOrder    @relation(fields: [poId], references: [id], onDelete: Cascade)
  approverId    String
  approver      User             @relation(fields: [approverId], references: [id])
  action        PoApprovalAction
  remarks       String?
  actionAt      DateTime         @default(now())
  approvalLevel Int

  @@map("po_approvals")
}

model GoodsReceiptNote {
  id               String            @id @default(uuid())
  instituteId      String?
  grnNumber        String            @unique
  poId             String
  po               PurchaseOrder     @relation(fields: [poId], references: [id])
  vendorId         String
  vendor           Vendor            @relation(fields: [vendorId], references: [id])
  receivedDate     DateTime
  warehouseId      String
  warehouse        Warehouse         @relation(fields: [warehouseId], references: [id])
  status           GrnStatus         @default(DRAFT)
  createdBy        String
  creator          User              @relation("CreatedGRNs", fields: [createdBy], references: [id])
  createdAt        DateTime          @default(now())
  items            GrnItem[]
  purchaseInvoices PurchaseInvoice[]

  @@index([instituteId])
  @@map("goods_receipt_notes")
}

model GrnItem {
  id          String            @id @default(uuid())
  grnId       String
  grn         GoodsReceiptNote  @relation(fields: [grnId], references: [id], onDelete: Cascade)
  poItemId    String
  poItem      PurchaseOrderItem @relation(fields: [poItemId], references: [id])
  itemId      String
  item        Item              @relation(fields: [itemId], references: [id])
  receivedQty Decimal           @db.Decimal(12, 2)
  acceptedQty Decimal           @db.Decimal(12, 2)
  rejectedQty Decimal           @db.Decimal(12, 2)

  @@map("grn_items")
}

model PurchaseInvoice {
  id                  String                @id @default(uuid())
  instituteId         String?
  invoiceNumber       String                @unique
  vendorInvoiceNumber String
  vendorId            String
  vendor              Vendor                @relation(fields: [vendorId], references: [id])
  poId                String?
  po                  PurchaseOrder?        @relation(fields: [poId], references: [id])
  grnId               String?
  grn                 GoodsReceiptNote?     @relation(fields: [grnId], references: [id])
  invoiceDate         DateTime
  dueDate             DateTime
  subtotal            Decimal               @db.Decimal(12, 2)
  taxAmount           Decimal               @db.Decimal(12, 2)
  discount            Decimal               @default(0) @db.Decimal(12, 2)
  grandTotal          Decimal               @db.Decimal(12, 2)
  paymentStatus       PaymentStatus         @default(UNPAID)
  status              InvoiceStatus         @default(DRAFT)
  createdBy           String
  creator             User                  @relation("CreatedPIs", fields: [createdBy], references: [id])
  postedBy            String?
  poster              User?                 @relation("PostedPIs", fields: [postedBy], references: [id])
  postedAt            DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  items               PurchaseInvoiceItem[]
  payments            PurchasePayment[]

  @@index([status, invoiceDate])
  @@index([vendorId])
  @@index([instituteId])
  @@map("purchase_invoices")
}

model PurchaseInvoiceItem {
  id                String          @id @default(uuid())
  purchaseInvoiceId String
  purchaseInvoice   PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  itemId            String
  item              Item            @relation(fields: [itemId], references: [id])
  quantity          Decimal         @db.Decimal(12, 2)
  unitPrice         Decimal         @db.Decimal(12, 2)
  taxCodeId         String
  taxCode           TaxCode         @relation(fields: [taxCodeId], references: [id])
  cgstAmount        Decimal         @db.Decimal(12, 2)
  sgstAmount        Decimal         @db.Decimal(12, 2)
  igstAmount        Decimal         @db.Decimal(12, 2)
  lineTotal         Decimal         @db.Decimal(12, 2)

  @@map("purchase_invoice_items")
}

model PurchasePayment {
  id                String          @id @default(uuid())
  instituteId       String?
  paymentNumber     String          @unique
  purchaseInvoiceId String
  purchaseInvoice   PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id])
  paymentDate       DateTime
  amount            Decimal         @db.Decimal(12, 2)
  mode              PaymentMode
  referenceNo       String?
  createdBy         String
  creator           User            @relation(fields: [createdBy], references: [id])
  createdAt         DateTime        @default(now())

  @@index([instituteId])
  @@map("purchase_payments")
}

model SalesOrder {
  id            String           @id @default(uuid())
  instituteId   String?
  soNumber      String           @unique
  customerId    String
  customer      Customer         @relation(fields: [customerId], references: [id])
  soDate        DateTime
  deliveryDate  DateTime
  status        SoStatus         @default(DRAFT)
  subtotal      Decimal          @db.Decimal(12, 2)
  taxAmount     Decimal          @db.Decimal(12, 2)
  discount      Decimal          @default(0) @db.Decimal(12, 2)
  grandTotal    Decimal          @db.Decimal(12, 2)
  createdBy     String
  creator       User             @relation("CreatedSOs", fields: [createdBy], references: [id])
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  items         SalesOrderItem[]
  salesInvoices SalesInvoice[]

  @@index([customerId])
  @@index([instituteId])
  @@map("sales_orders")
}

model SalesOrderItem {
  id          String     @id @default(uuid())
  soId        String
  so          SalesOrder @relation(fields: [soId], references: [id], onDelete: Cascade)
  itemId      String
  item        Item       @relation(fields: [itemId], references: [id])
  quantity    Decimal    @db.Decimal(12, 2)
  unitPrice   Decimal    @db.Decimal(12, 2)
  taxCodeId   String
  taxCode     TaxCode    @relation(fields: [taxCodeId], references: [id])
  lineTotal   Decimal    @db.Decimal(12, 2)
  invoicedQty Decimal    @default(0) @db.Decimal(12, 2)

  @@map("sales_order_items")
}

model SalesInvoice {
  id            String             @id @default(uuid())
  instituteId   String?
  invoiceNumber String             @unique
  customerId    String
  customer      Customer           @relation(fields: [customerId], references: [id])
  soId          String?
  so            SalesOrder?        @relation(fields: [soId], references: [id])
  invoiceDate   DateTime
  dueDate       DateTime
  subtotal      Decimal            @db.Decimal(12, 2)
  taxAmount     Decimal            @db.Decimal(12, 2)
  discount      Decimal            @default(0) @db.Decimal(12, 2)
  grandTotal    Decimal            @db.Decimal(12, 2)
  paymentStatus PaymentStatus      @default(UNPAID)
  status        InvoiceStatus      @default(DRAFT)
  createdBy     String
  creator       User               @relation("CreatedSIs", fields: [createdBy], references: [id])
  postedBy      String?
  poster        User?              @relation("PostedSIs", fields: [postedBy], references: [id])
  postedAt      DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  items         SalesInvoiceItem[]
  receipts      SalesReceipt[]

  @@index([status, invoiceDate])
  @@index([customerId])
  @@index([instituteId])
  @@map("sales_invoices")
}

model SalesInvoiceItem {
  id             String       @id @default(uuid())
  salesInvoiceId String
  salesInvoice   SalesInvoice @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  itemId         String
  item           Item         @relation(fields: [itemId], references: [id])
  quantity       Decimal      @db.Decimal(12, 2)
  unitPrice      Decimal      @db.Decimal(12, 2)
  taxCodeId      String
  taxCode        TaxCode      @relation(fields: [taxCodeId], references: [id])
  cgstAmount     Decimal      @db.Decimal(12, 2)
  sgstAmount     Decimal      @db.Decimal(12, 2)
  igstAmount     Decimal      @db.Decimal(12, 2)
  lineTotal      Decimal      @db.Decimal(12, 2)

  @@map("sales_invoice_items")
}

model SalesReceipt {
  id             String       @id @default(uuid())
  instituteId    String?
  receiptNumber  String       @unique
  salesInvoiceId String
  salesInvoice   SalesInvoice @relation(fields: [salesInvoiceId], references: [id])
  receiptDate    DateTime
  amount         Decimal      @db.Decimal(12, 2)
  mode           PaymentMode
  referenceNo    String?
  createdBy      String
  creator        User         @relation(fields: [createdBy], references: [id])
  createdAt      DateTime     @default(now())

  @@index([instituteId])
  @@map("sales_receipts")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  entityType String
  entityId   String
  action     String
  oldStatus  String?
  newStatus  String?
  reason     String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@map("audit_logs")
}

enum InventoryTransactionType {
  PURCHASE_GRN
  SALES_DISPATCH
  STOCK_ADJUSTMENT
  OPENING_STOCK
  RETURN_IN
  RETURN_OUT
}

model InventoryTransaction {
  id              String                   @id @default(uuid())
  instituteId     String?
  itemId          String
  item            Item                     @relation(fields: [itemId], references: [id])
  warehouseId     String?
  warehouse       Warehouse?               @relation(fields: [warehouseId], references: [id])
  transactionType InventoryTransactionType
  referenceType   String
  referenceId     String
  documentNumber  String
  quantityIn      Decimal                  @default(0) @db.Decimal(12, 3)
  quantityOut     Decimal                  @default(0) @db.Decimal(12, 3)
  balanceQuantity Decimal                  @db.Decimal(12, 3)
  remarks         String?
  createdBy       String
  creator         User                     @relation(fields: [createdBy], references: [id])
  createdAt       DateTime                 @default(now())

  @@index([itemId, createdAt])
  @@index([instituteId])
  @@map("inventory_transactions")
}

// ==========================================
// CANTEEN MODULE ENUMS & MODELS
// ==========================================

enum CanteenFoodType {
  VEG
  NON_VEG
  EGG
}

enum CanteenMemberType {
  STUDENT
  STAFF
}

enum CanteenOrderStatus {
  PLACED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum CanteenPaymentStatus {
  UNPAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
}

enum CanteenPaymentMode {
  CASH
  CARD
  UPI
  WALLET
}

enum CanteenTopupStatus {
  SUCCESS
  PENDING
  FAILED
}

enum CanteenTopupMode {
  CASH
  CARD
  UPI
  BANK_TRANSFER
}

enum CanteenWalletStatus {
  ACTIVE
  BLOCKED
}

enum CanteenWalletTransType {
  CREDIT
  DEBIT
}

enum CanteenWalletRefType {
  TOPUP
  ORDER_PAYMENT
  REFUND
  ADJUSTMENT
}

// --- Canteen RBAC Models ---
model CanteenRole {
  id              String                  @id @default(uuid())
  name            String                  @unique
  description     String?
  isSystem        Boolean                 @default(false)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  rolePermissions CanteenRolePermission[]
  userRoles       CanteenUserRole[]

  @@map("canteen_roles")
}

model CanteenPermission {
  id              String                  @id @default(uuid())
  key             String                  @unique
  name            String
  description     String?
  module          String                  @default("canteen")
  resource        String?
  action          String?
  isSystem        Boolean                 @default(true)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  rolePermissions CanteenRolePermission[]

  @@map("canteen_permissions")
}

model CanteenRolePermission {
  id           String            @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime          @default(now())
  role         CanteenRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   CanteenPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("canteen_role_permissions")
}

model CanteenUserRole {
  id         String      @id @default(uuid())
  userId     String
  roleId     String
  assignedBy String?
  createdAt  DateTime    @default(now())
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       CanteenRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("canteen_user_roles")
}

// --- Canteen Menu Models ---
model CanteenMenuCategory {
  id           String            @id @default(uuid())
  name         String            @unique
  displayOrder Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  items        CanteenMenuItem[]

  @@map("canteen_menu_categories")
}

model CanteenMenuItem {
  id            String                @id @default(uuid())
  categoryId    String
  name          String
  description   String?
  price         Decimal               @db.Decimal(12, 2)
  taxRate       Decimal               @default(0) @db.Decimal(5, 2)
  foodType      CanteenFoodType       @default(VEG)
  imageUrl      String?
  isAvailable   Boolean               @default(true)
  availableDays String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  category      CanteenMenuCategory   @relation(fields: [categoryId], references: [id])
  schedules     CanteenMenuSchedule[]
  orderItems    CanteenOrderItem[]

  @@index([categoryId, isAvailable])
  @@map("canteen_menu_items")
}

model CanteenMenuSchedule {
  id        String          @id @default(uuid())
  itemId    String
  dayOfWeek String
  startTime String
  endTime   String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  item      CanteenMenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@map("canteen_menu_schedules")
}

// --- Canteen Member Model ---
model CanteenMember {
  id            String            @id @default(uuid())
  externalRefId String?
  name          String
  memberType    CanteenMemberType @default(STUDENT)
  idCardBarcode String            @unique
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  wallet        CanteenWallet?
  orders        CanteenOrder[]

  @@index([idCardBarcode])
  @@index([externalRefId])
  @@map("canteen_members")
}

// --- Canteen POS Models ---
model CanteenPosTerminal {
  id        String            @id @default(uuid())
  name      String            @unique
  location  String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  shifts    CanteenPosShift[]
  orders    CanteenOrder[]

  @@map("canteen_pos_terminals")
}

model CanteenPosShift {
  id           String             @id @default(uuid())
  terminalId   String
  staffId      String
  openingCash  Decimal            @db.Decimal(12, 2)
  closingCash  Decimal?           @db.Decimal(12, 2)
  expectedCash Decimal?           @db.Decimal(12, 2)
  variance     Decimal?           @db.Decimal(12, 2)
  shiftStart   DateTime           @default(now())
  shiftEnd     DateTime?
  status       String             @default("OPEN")
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  terminal     CanteenPosTerminal @relation(fields: [terminalId], references: [id])
  staff        User               @relation(fields: [staffId], references: [id])

  @@map("canteen_pos_shifts")
}

// --- Canteen Order & Payment Models ---
model CanteenOrder {
  id             String               @id @default(uuid())
  orderNumber    String               @unique
  memberId       String?
  terminalId     String?
  orderDate      DateTime             @default(now())
  orderTime      DateTime             @default(now())
  subtotal       Decimal              @db.Decimal(12, 2)
  taxAmount      Decimal              @default(0) @db.Decimal(12, 2)
  discountAmount Decimal              @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal              @db.Decimal(12, 2)
  status         CanteenOrderStatus   @default(PLACED)
  paymentStatus  CanteenPaymentStatus @default(UNPAID)
  createdBy      String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  member         CanteenMember?       @relation(fields: [memberId], references: [id])
  terminal       CanteenPosTerminal?  @relation(fields: [terminalId], references: [id])
  creator        User                 @relation("CreatedCanteenOrders", fields: [createdBy], references: [id])
  items          CanteenOrderItem[]
  payments       CanteenPayment[]

  @@index([orderDate, terminalId])
  @@index([status])
  @@index([paymentStatus])
  @@map("canteen_orders")
}

model CanteenOrderItem {
  id        String          @id @default(uuid())
  orderId   String
  itemId    String
  quantity  Int
  unitPrice Decimal         @db.Decimal(12, 2)
  subtotal  Decimal         @db.Decimal(12, 2)
  order     CanteenOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item      CanteenMenuItem @relation(fields: [itemId], references: [id])

  @@index([orderId])
  @@map("canteen_order_items")
}

model CanteenPayment {
  id             String             @id @default(uuid())
  orderId        String
  paymentMode    CanteenPaymentMode
  amount         Decimal            @db.Decimal(12, 2)
  transactionRef String?
  status         String             @default("success")
  paidAt         DateTime           @default(now())
  receivedBy     String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  order          CanteenOrder       @relation(fields: [orderId], references: [id])
  receiver       User?              @relation("ReceivedCanteenPayments", fields: [receivedBy], references: [id])

  @@index([orderId])
  @@map("canteen_payments")
}

// --- Canteen Wallet Models ---
model CanteenWallet {
  id              String                     @id @default(uuid())
  memberId        String                     @unique
  balance         Decimal                    @default(0) @db.Decimal(12, 2)
  status          CanteenWalletStatus        @default(ACTIVE)
  dailySpendLimit Decimal?                   @db.Decimal(12, 2)
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  member          CanteenMember              @relation(fields: [memberId], references: [id], onDelete: Cascade)
  topups          CanteenWalletTopup[]
  transactions    CanteenWalletTransaction[]

  @@map("canteen_wallets")
}

model CanteenWalletTopup {
  id             String             @id @default(uuid())
  walletId       String
  amount         Decimal            @db.Decimal(12, 2)
  paymentMode    CanteenTopupMode   @default(CASH)
  transactionRef String?
  topupDate      DateTime           @default(now())
  approvedBy     String?
  status         CanteenTopupStatus @default(SUCCESS)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  wallet         CanteenWallet      @relation(fields: [walletId], references: [id], onDelete: Cascade)
  approver       User?              @relation("ApprovedCanteenTopups", fields: [approvedBy], references: [id])

  @@index([walletId, topupDate])
  @@map("canteen_wallet_topups")
}

model CanteenWalletTransaction {
  id            String                 @id @default(uuid())
  walletId      String
  type          CanteenWalletTransType
  amount        Decimal                @db.Decimal(12, 2)
  referenceType CanteenWalletRefType
  referenceId   String?
  balanceAfter  Decimal                @db.Decimal(12, 2)
  transactedAt  DateTime               @default(now())
  createdBy     String?
  wallet        CanteenWallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, transactedAt])
  @@map("canteen_wallet_transactions")
}

model LibCategory {
  category_id Int       @id @default(autoincrement())
  name        String    @unique
  books       LibBook[]

  @@map("library_categories")
}

model LibMember {
  member_id           Int                  @id @default(autoincrement())
  external_ref_id     String?
  name                String
  member_type         LibMemberType
  library_card_number String               @unique
  status              LibMemberStatus      @default(active)
  created_at          DateTime             @default(now())
  updated_at          DateTime             @updatedAt
  fines               LibFine[]
  issue_records       LibIssueRecord[]
  notification_logs   LibNotificationLog[]
  reservations        LibReservation[]

  @@map("library_members")
}

model LibUser {
  user_id         Int              @id @default(autoincrement())
  name            String
  role            LibUserRole
  created_at      DateTime         @default(now())
  payments        LibFinePayment[]
  issues_made     LibIssueRecord[] @relation("IssuedBy")
  returns_handled LibIssueRecord[] @relation("ReturnedTo")

  @@map("library_users")
}

model LibMembershipRule {
  rule_id           Int           @id @default(autoincrement())
  member_type       LibMemberType @unique
  max_books_allowed Int
  loan_period_days  Int
  fine_per_day      Decimal       @db.Decimal(10, 2)
  grace_period_days Int           @default(0)
  max_fine_cap      Decimal?      @db.Decimal(10, 2)
  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt

  @@map("library_membership_rules")
}

model LibBook {
  book_id         Int              @id @default(autoincrement())
  isbn            String?          @unique
  title           String
  author          String
  publisher       String?
  edition         String?
  category_id     Int
  language        String?          @default("English")
  publish_year    Int?
  description     String?
  cover_image_url String?
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt
  copies          LibBookCopy[]
  vendors         LibBookVendor[]
  category        LibCategory      @relation(fields: [category_id], references: [category_id])
  reservations    LibReservation[]

  @@map("library_books")
}

model LibBookVendor {
  book_vendor_id      Int      @id @default(autoincrement())
  book_id             Int
  vendor_name         String
  name                String?
  contact_person      String?
  phone               String?
  email               String?
  address             String?
  last_purchase_price Decimal? @db.Decimal(10, 2)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt
  book                LibBook  @relation(fields: [book_id], references: [book_id])

  @@map("library_book_vendors")
}

model LibBookCopy {
  copy_id          Int              @id @default(autoincrement())
  book_id          Int
  barcode          String           @unique
  accession_number String           @unique
  rack_location    String?
  condition        LibCopyCondition @default(new)
  status           LibCopyStatus    @default(available)
  acquired_date    DateTime?        @db.Date
  price            Decimal?         @db.Decimal(10, 2)
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt
  book             LibBook          @relation(fields: [book_id], references: [book_id])
  issue_records    LibIssueRecord[]

  @@map("library_book_copies")
}

model LibIssueRecord {
  issue_id          Int            @id @default(autoincrement())
  copy_id           Int
  member_id         Int
  issue_date        DateTime       @db.Date
  due_date          DateTime       @db.Date
  return_date       DateTime?      @db.Date
  renewal_count     Int            @default(0)
  status            LibIssueStatus @default(issued)
  issued_by         Int
  returned_to       Int?
  fine_per_day      Decimal        @db.Decimal(10, 2)
  grace_period_days Int            @default(0)
  max_fine_cap      Decimal?       @db.Decimal(10, 2)
  created_at        DateTime       @default(now())
  updated_at        DateTime       @updatedAt
  fines             LibFine[]
  copy              LibBookCopy    @relation(fields: [copy_id], references: [copy_id])
  issuer            LibUser        @relation("IssuedBy", fields: [issued_by], references: [user_id])
  member            LibMember      @relation(fields: [member_id], references: [member_id])
  returner          LibUser?       @relation("ReturnedTo", fields: [returned_to], references: [user_id])

  @@map("library_issue_records")
}

model LibReservation {
  reservation_id Int                  @id @default(autoincrement())
  book_id        Int
  member_id      Int
  reserved_date  DateTime             @db.Date
  status         LibReservationStatus @default(pending)
  expiry_date    DateTime             @db.Date
  created_at     DateTime             @default(now())
  updated_at     DateTime             @updatedAt
  book           LibBook              @relation(fields: [book_id], references: [book_id])
  member         LibMember            @relation(fields: [member_id], references: [member_id])

  @@map("library_reservations")
}

model LibFine {
  fine_id       Int              @id @default(autoincrement())
  issue_id      Int
  member_id     Int
  reason        LibFineReason
  amount        Decimal          @db.Decimal(10, 2)
  status        LibFineStatus    @default(pending)
  calculated_at DateTime         @default(now())
  updated_at    DateTime         @updatedAt
  payments      LibFinePayment[]
  issue_record  LibIssueRecord   @relation(fields: [issue_id], references: [issue_id])
  member        LibMember        @relation(fields: [member_id], references: [member_id])

  @@map("library_fines")
}

model LibFinePayment {
  payment_id       Int            @id @default(autoincrement())
  fine_id          Int
  amount_paid      Decimal        @db.Decimal(10, 2)
  payment_date     DateTime       @db.Date
  payment_mode     LibPaymentMode
  received_by      Int
  transaction_ref  String?
  created_at       DateTime       @default(now())
  fine             LibFine        @relation(fields: [fine_id], references: [fine_id])
  received_by_user LibUser        @relation(fields: [received_by], references: [user_id])

  @@map("library_fine_payments")
}

model LibNotificationLog {
  log_id     Int       @id @default(autoincrement())
  member_id  Int
  event_type String
  ref_id     Int?
  created_at DateTime  @default(now())
  member     LibMember @relation(fields: [member_id], references: [member_id])

  @@map("library_notification_logs")
}

model LibDynamicRole {
  role_id      Int                  @id @default(autoincrement())
